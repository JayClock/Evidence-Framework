{
  "name": "@evidence-poc/evidence-model-io",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "FM 模型源树的磁盘适配：目录读写、单文件 Bundle 打包与解包、模型根指纹",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "evidence-model": "./dist/cli.js"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@evidence-poc/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./cli": {
      "@evidence-poc/source": "./src/cli.ts",
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js",
      "default": "./dist/cli.js"
    }
  },
  "nx": {
    "name": "evidence-model-io",
    "tags": [
      "type:lib",
      "layer:io",
      "platform:node",
      "scope:model"
    ]
  },
  "dependencies": {
    "@evidence-poc/evidence-model-core": "workspace:*",
    "@evidence-poc/evidence-schema": "workspace:*",
    "tslib": "^2.3.0"
  }
}
