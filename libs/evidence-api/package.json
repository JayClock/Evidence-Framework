{
  "name": "@evidence-poc/evidence-api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "从 FM 模型派生 API 草稿、增量差异、超媒体导航与 OpenAPI 交付契约",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@evidence-poc/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./delivery": {
      "@evidence-poc/source": "./src/delivery.ts",
      "types": "./dist/delivery.d.ts",
      "import": "./dist/delivery.js",
      "default": "./dist/delivery.js"
    },
    "./testing": {
      "@evidence-poc/source": "./src/testing/index.ts",
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js",
      "default": "./dist/testing/index.js"
    }
  },
  "nx": {
    "name": "evidence-api",
    "tags": [
      "type:lib",
      "layer:projection",
      "platform:node",
      "surface:browser-safe",
      "scope:api"
    ],
    "targets": {
      "export-openapi": {
        "executor": "nx:run-commands",
        "cache": false,
        "dependsOn": [
          {
            "target": "build",
            "projects": [
              "cli"
            ]
          }
        ],
        "options": {
          "command": "node apps/cli/dist/cli.js api deliver",
          "cwd": "."
        }
      }
    }
  },
  "dependencies": {
    "@evidence-poc/evidence-model-core": "workspace:*",
    "@evidence-poc/evidence-model-io": "workspace:*",
    "@evidence-poc/evidence-schema": "workspace:*",
    "@seriousme/openapi-schema-validator": "2.11.0",
    "ajv": "^8.20.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "openapi-typescript": "7.13.0",
    "typescript": "~6.0.3"
  }
}
