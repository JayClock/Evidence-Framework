{
  "name": "@evidence-poc/evidence-api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "从 FM 模型派生 API 草稿、增量差异、超媒体导航与 OpenAPI 交付契约",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "evidence-api": "./dist/cli.js"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@evidence-poc/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./cli": {
      "@evidence-poc/source": "./src/cli.ts",
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js",
      "default": "./dist/cli.js"
    }
  },
  "nx": {
    "name": "evidence-api",
    "tags": [
      "type:lib",
      "scope:evidence"
    ]
  },
  "dependencies": {
    "@evidence-poc/evidence-model-core": "workspace:*",
    "@evidence-poc/evidence-model-io": "workspace:*",
    "@evidence-poc/evidence-schema": "workspace:*",
    "ajv": "^8.20.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@seriousme/openapi-schema-validator": "2.11.0",
    "openapi-typescript": "7.13.0",
    "typescript": "~6.0.3"
  }
}
