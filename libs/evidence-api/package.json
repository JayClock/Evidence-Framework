{
  "name": "@evidence-poc/evidence-api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "从 FM 模型派生 API 草稿、增量差异、超媒体导航与 OpenAPI 交付契约",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "evidence-api": "./dist/cli.js"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@evidence-poc/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./commands": {
      "@evidence-poc/source": "./src/commands.ts",
      "types": "./dist/commands.d.ts",
      "import": "./dist/commands.js",
      "default": "./dist/commands.js"
    },
    "./cli": {
      "@evidence-poc/source": "./src/cli.ts",
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js",
      "default": "./dist/cli.js"
    },
    "./runner": {
      "@evidence-poc/source": "./src/runner/acceptanceRunner.ts",
      "types": "./dist/runner/acceptanceRunner.d.ts",
      "import": "./dist/runner/acceptanceRunner.js",
      "default": "./dist/runner/acceptanceRunner.js"
    },
    "./delivery": {
      "@evidence-poc/source": "./src/delivery.ts",
      "types": "./dist/delivery.d.ts",
      "import": "./dist/delivery.js",
      "default": "./dist/delivery.js"
    }
  },
  "nx": {
    "name": "evidence-api",
    "tags": [
      "type:lib",
      "layer:projection",
      "platform:node",
      "surface:browser-safe",
      "scope:api"
    ],
    "targets": {
      "export-openapi": {
        "executor": "nx:run-commands",
        "cache": false,
        "dependsOn": [
          {
            "target": "build",
            "projects": [
              "cli"
            ]
          }
        ],
        "options": {
          "command": "node apps/cli/dist/cli.js api deliver",
          "cwd": "."
        }
      },
      "export-tests": {
        "executor": "nx:run-commands",
        "cache": false,
        "dependsOn": [
          {
            "target": "build",
            "projects": [
              "cli"
            ]
          }
        ],
        "options": {
          "command": "node apps/cli/dist/cli.js api export-tests",
          "cwd": "."
        }
      },
      "diff": {
        "executor": "nx:run-commands",
        "cache": false,
        "dependsOn": [
          {
            "target": "build",
            "projects": [
              "cli"
            ]
          }
        ],
        "options": {
          "command": "node apps/cli/dist/cli.js api diff",
          "cwd": "."
        }
      },
      "test": {
        "cache": false
      }
    }
  },
  "dependencies": {
    "@evidence-poc/evidence-model-core": "workspace:*",
    "@evidence-poc/evidence-model-io": "workspace:*",
    "@evidence-poc/evidence-schema": "workspace:*",
    "@seriousme/openapi-schema-validator": "2.11.0",
    "@stepci/runner": "2.0.7",
    "ajv": "^8.20.0",
    "ajv-formats": "3.0.1",
    "cac": "^6.7.14",
    "tslib": "^2.3.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "openapi-typescript": "7.13.0",
    "typescript": "~6.0.3"
  }
}
