{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jayclock.dev/fm/v5/entity.schema.json",
  "title": "Progressively modeled Entity with mandatory responsibility",
  "type": "object",
  "required": ["type", "id", "category", "label"],
  "properties": {
    "type": { "const": "entity" },
    "id": { "$ref": "#/$defs/id" },
    "category": {
      "enum": ["evidence", "participant", "role", "context"]
    },
    "kind": { "type": "string", "minLength": 1 },
    "label": { "type": "string", "minLength": 1 },
    "aliases": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "contextRef": { "$ref": "#/$defs/id" },
    "parentContextRef": { "$ref": "#/$defs/id" },
    "rootRefs": {
      "type": "array",
      "items": { "$ref": "#/$defs/id" },
      "minItems": 1,
      "uniqueItems": true
    },
    "responsibleRoleRef": { "$ref": "#/$defs/id" },
    "roleRefs": {
      "description": "A Contract is stored together with exactly two contextual Party Roles; actual players may be unknown.",
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "$ref": "#/$defs/id" },
      "uniqueItems": true
    },
    "attributes": {
      "type": "array",
      "items": { "$ref": "#/$defs/attribute" },
      "uniqueItems": true
    },
    "notes": { "type": "string", "minLength": 1 },
    "sourceSnippet": { "$ref": "#/$defs/provenance" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "category": { "const": "evidence" } },
        "required": ["category"]
      },
      "then": {
        "required": ["contextRef"],
        "properties": {
          "kind": {
            "enum": [
              "rfp",
              "proposal",
              "contract",
              "fulfillment_request",
              "fulfillment_confirmation",
              "other_evidence"
            ]
          },
          "attributes": {
            "items": {
              "if": {
                "properties": {
                  "name": {
                    "enum": [
                      "started_at",
                      "expired_at",
                      "signed_at",
                      "confirmed_at",
                      "created_at"
                    ]
                  }
                },
                "required": ["name"]
              },
              "then": {
                "properties": {
                  "valueType": { "const": "timestamp" },
                  "required": { "const": true },
                  "keyData": { "const": true }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "category": { "const": "evidence" },
          "kind": {
            "enum": [
              "rfp",
              "proposal",
              "fulfillment_request",
              "fulfillment_confirmation",
              "other_evidence"
            ]
          }
        },
        "required": ["category", "kind"]
      },
      "then": { "required": ["responsibleRoleRef"] }
    },
    {
      "if": {
        "properties": {
          "category": { "const": "evidence" },
          "kind": { "const": "contract" }
        },
        "required": ["category", "kind"]
      },
      "then": { "required": ["roleRefs"] }
    },
    {
      "if": {
        "properties": { "category": { "const": "participant" } },
        "required": ["category"]
      },
      "then": { "properties": { "kind": { "enum": ["party", "thing"] } } }
    },
    {
      "if": {
        "properties": {
          "category": { "const": "participant" },
          "kind": { "const": "thing" }
        },
        "required": ["category", "kind"]
      },
      "then": { "required": ["contextRef"] }
    },
    {
      "if": {
        "properties": { "category": { "const": "role" } },
        "required": ["category"]
      },
      "then": {
        "properties": {
          "kind": {
            "enum": ["party", "domain", "third_party", "context", "evidence"]
          }
        },
        "required": ["contextRef"],
        "not": {
          "anyOf": [
            { "required": ["responsibleRoleRef"] },
            { "required": ["roleRefs"] }
          ]
        }
      }
    },
    {
      "if": {
        "properties": { "category": { "const": "context" } },
        "required": ["category"]
      },
      "then": {
        "properties": {
          "kind": { "enum": ["contract", "pre_contract", "domain"] }
        }
      }
    },
    {
      "if": {
        "properties": {
          "category": { "const": "context" },
          "kind": { "enum": ["contract", "domain"] }
        },
        "required": ["category", "kind"]
      },
      "then": { "required": ["rootRefs"] }
    },
    {
      "if": {
        "properties": {
          "category": { "enum": ["context", "evidence", "participant", "role"] }
        },
        "required": ["category"]
      },
      "then": { "required": ["kind"] }
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$" },
    "provenance": {
      "description": "Sentence an ingested element was read from, so a reviewer can re-read the clause instead of trusting the extraction.",
      "type": "object",
      "required": ["text"],
      "properties": {
        "text": { "type": "string", "minLength": 1 },
        "locator": { "type": "string", "minLength": 1 },
        "source": {
          "enum": ["contract", "prd", "interview", "blueprint", "unknown"]
        }
      },
      "additionalProperties": false
    },
    "attribute": {
      "type": "object",
      "required": ["name", "label", "meaning"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
        },
        "label": { "type": "string", "minLength": 1 },
        "valueType": {
          "enum": [
            "bool",
            "int",
            "uint",
            "double",
            "decimal",
            "string",
            "bytes",
            "timestamp",
            "duration",
            "date",
            "money",
            "enum",
            "id",
            "list",
            "map",
            "dynamic"
          ]
        },
        "required": { "type": "boolean" },
        "keyData": { "type": "boolean" },
        "meaning": { "type": "string", "minLength": 1 },
        "derivedByRuleRef": { "$ref": "#/$defs/id" },
        "notes": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  }
}
