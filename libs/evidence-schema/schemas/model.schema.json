{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jayclock.dev/fm/v6/model.schema.json",
  "title": "Fulfillment Modeling manifest",
  "type": "object",
  "required": [
    "type",
    "schemaVersion",
    "id",
    "name",
    "version",
    "ruleLanguage",
    "entryContextRefs"
  ],
  "properties": {
    "type": { "const": "fm_model" },
    "schemaVersion": { "const": "6.0" },
    "id": { "$ref": "#/$defs/id" },
    "name": { "type": "string", "minLength": 1 },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "ruleLanguage": { "const": "CEL" },
    "entryContextRefs": {
      "type": "array",
      "items": { "$ref": "#/$defs/id" },
      "uniqueItems": true
    },
    "description": { "type": "string", "minLength": 1 },
    "sourceDocument": {
      "type": "object",
      "required": ["text", "clauses"],
      "properties": {
        "text": { "type": "string", "minLength": 1 },
        "clauses": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "index",
              "text",
              "category",
              "reason",
              "charStart",
              "charEnd"
            ],
            "properties": {
              "index": { "type": "integer", "minimum": 1 },
              "text": { "type": "string", "minLength": 1 },
              "category": { "enum": ["business", "domain", "boilerplate"] },
              "reason": { "type": "string" },
              "charStart": { "type": "integer", "minimum": 0 },
              "charEnd": { "type": "integer", "minimum": 1 }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
    }
  }
}
