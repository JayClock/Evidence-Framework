      "type": "relationship",
      "id": "relation.dispute-refund",
      "kind": "references",
      "sourceRef": "evidence.dispute",
      "targetRef": "request.refund",
      "label": "退款争议移交",
      "flowKind": "escalation",
      "notes": "移交买方争议处理专员，以受理记录为边界，不声称司法终局。"
    }
