meta {
  name: contract.ads-promotion-order#payment-order
  type: http
  seq: 1
}

post {
  url: {{host}}/ads-promotion-orders
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  x-evidence-role: role.advertiser
  x-evidence-asof: {{asOf_10}}
}

body:json {
  {
    "agreed_amount_minor": 250000,
    "campaign_id": "campaign-pay",
    "id": "ads-order-pay"
  }
}

vars:post-response {
  capture_2_1_1: res.body?.id
}

assert {
  res.status: eq 201
  res.body?.agreed_amount_minor: eq 250000
  res.body?.campaign_id: eq "campaign-pay"
  res.body?.id: eq "ads-order-pay"
  res.body?.signed_at: eq "2026-06-01T09:00:00Z"
}

settings {
  followRedirects: false
  timeout: 5000
}
