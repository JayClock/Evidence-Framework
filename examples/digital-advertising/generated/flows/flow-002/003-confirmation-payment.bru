meta {
  name: confirmation.payment#gateway-paid
  type: http
  seq: 3
}

post {
  url: {{host}}/ads-promotion-orders/{{capture_2_1_1}}/payment/confirmation
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  x-evidence-role: role.payment-gateway
  x-evidence-asof: {{asOf_12}}
}

body:json {
  {
    "gateway_reference": "gateway-txn-01",
    "id": "payment-proof-one"
  }
}

assert {
  res.status: eq 201
  res.body?.confirmed_at: eq "2026-06-01T10:00:00Z"
  res.body?.gateway_reference: eq "gateway-txn-01"
  res.body?.id: eq "payment-proof-one"
  res.body?.paid_amount_minor: eq 250000
}

settings {
  followRedirects: false
  timeout: 5000
}
