meta {
  name: request.advertising#request-launch
  type: http
  seq: 6
}

post {
  url: {{host}}/ads-promotion-orders/{{capture_1_3_1}}/advertising
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  x-evidence-role: role.advertiser
  x-evidence-asof: {{asOf_6}}
}

body:json {
  {
    "id": "launch-request-summer",
    "placement": "首页推荐位"
  }
}

assert {
  res.status: eq 201
  res.body?.expired_at: eq "2026-07-03T13:00:00Z"
  res.body?.id: eq "launch-request-summer"
  res.body?.started_at: eq "2026-07-01T13:00:00Z"
}

tests {
  test("$[\"placement\"]", function () {
    expect(res.body?.placement).to.equal("首页推荐位");
  });
}

settings {
  followRedirects: false
  timeout: 5000
}
