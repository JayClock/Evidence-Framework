meta {
  name: confirmation.payment#summer-payment-proof
  type: http
  seq: 5
}

post {
  url: {{host}}/ads-promotion-orders/{{capture_1_3_1}}/payment/confirmation
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  x-evidence-role: role.payment-gateway
  x-evidence-asof: {{asOf_5}}
}

body:json {
  {
    "gateway_reference": "gateway-txn-02",
    "id": "payment-proof-summer"
  }
}

assert {
  res.status: eq 201
  res.body?.confirmed_at: eq "2026-07-01T12:00:00Z"
  res.body?.gateway_reference: eq "gateway-txn-02"
  res.body?.id: eq "payment-proof-summer"
  res.body?.paid_amount_minor: eq 720000
}

settings {
  followRedirects: false
  timeout: 5000
}
