meta {
  name: proposal.ads-promotion-proposal#return-quote
  type: http
  seq: 2
}

post {
  url: {{host}}/ads-promotion-inquiries/{{capture_1_1_1}}/ads-promotion-proposal
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  x-evidence-role: role.agency
  x-evidence-asof: {{asOf_2}}
}

body:json {
  {
    "id": "quote-summer",
    "placement": "首页推荐位",
    "quoted_amount_minor": 720000
  }
}

assert {
  res.status: eq 201
  res.body?.expired_at: eq "2026-07-03T10:00:00Z"
  res.body?.id: eq "quote-summer"
  res.body?.quoted_amount_minor: eq 720000
  res.body?.started_at: eq "2026-07-01T10:00:00Z"
}

tests {
  test("$[\"placement\"]", function () {
    expect(res.body?.placement).to.equal("首页推荐位");
  });
}

settings {
  followRedirects: false
  timeout: 5000
}
