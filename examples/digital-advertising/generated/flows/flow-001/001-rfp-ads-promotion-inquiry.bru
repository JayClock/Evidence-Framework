meta {
  name: rfp.ads-promotion-inquiry#request-campaign-plan
  type: http
  seq: 1
}

post {
  url: {{host}}/ads-promotion-inquiries
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  x-evidence-role: role.advertiser
  x-evidence-asof: {{asOf}}
}

body:json {
  {
    "budget_minor": 800000,
    "id": "inquiry-summer",
    "objective": "推广夏季新品"
  }
}

vars:post-response {
  capture_1_1_1: res.body?.id
}

assert {
  res.status: eq 201
  res.body?.budget_minor: eq 800000
  res.body?.expired_at: eq "2026-07-04T09:00:00Z"
  res.body?.id: eq "inquiry-summer"
  res.body?.started_at: eq "2026-07-01T09:00:00Z"
}

tests {
  test("$[\"objective\"]", function () {
    expect(res.body?.objective).to.equal("推广夏季新品");
  });
}

settings {
  followRedirects: false
  timeout: 5000
}
