meta {
  name: contract.ads-promotion-order#sign-campaign-order
  type: http
  seq: 3
}

post {
  url: {{host}}/ads-promotion-inquiries/{{capture_1_1_1}}/ads-promotion-proposal/ads-promotion-orders
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  x-evidence-role: role.advertiser
  x-evidence-asof: {{asOf_3}}
}

body:json {
  {
    "agreed_amount_minor": 720000,
    "campaign_id": "campaign-summer",
    "id": "ads-order-summer"
  }
}

vars:post-response {
  capture_1_3_1: res.body?.id
}

assert {
  res.status: eq 201
  res.body?.agreed_amount_minor: eq 720000
  res.body?.campaign_id: eq "campaign-summer"
  res.body?.id: eq "ads-order-summer"
  res.body?.signed_at: eq "2026-07-01T11:00:00Z"
}

settings {
  followRedirects: false
  timeout: 5000
}
