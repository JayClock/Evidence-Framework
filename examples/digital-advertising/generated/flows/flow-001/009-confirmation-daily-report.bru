meta {
  name: confirmation.daily-report#report-published
  type: http
  seq: 9
}

post {
  url: {{host}}/ads-promotion-orders/{{capture_1_3_1}}/daily-reports/{{capture_1_8_1}}/confirmation
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  x-evidence-role: role.agency
  x-evidence-asof: {{asOf_9}}
}

body:json {
  {
    "id": "daily-report-summer",
    "impressions": 12904,
    "report_ref": "archive-summer-20260702"
  }
}

assert {
  res.status: eq 201
  res.body?._links?.self?.href: eq "/daily-report-confirmations/daily-report-summer"
  res.body?.confirmed_at: eq "2026-07-03T00:20:00Z"
  res.body?.id: eq "daily-report-summer"
  res.body?.impressions: eq 12904
  res.body?.report_ref: eq "archive-summer-20260702"
}

settings {
  followRedirects: false
  timeout: 5000
}
