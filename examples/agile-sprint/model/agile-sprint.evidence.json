  "relationships": [
    {
      "type": "relationship",
      "id": "relation.party.product-owner-role.product-owner",
      "kind": "plays_role",
      "sourceRef": "party.product-owner",
      "targetRef": "role.product-owner",
      "label": "扮演产品负责人"
    },
    {
      "type": "relationship",
      "id": "relation.party.development-team-role.development-team",
      "kind": "plays_role",
      "sourceRef": "party.development-team",
      "targetRef": "role.development-team",
      "label": "扮演研发团队"
    },
    {
      "type": "relationship",
      "id": "relation.request.backlog-contract.iteration-plan",
      "kind": "references",
      "sourceRef": "request.backlog",
      "targetRef": "contract.iteration-plan",
      "label": "在协议约定范围内发起履约",
      "sourceCardinality": {
        "min": 0,
        "max": 1
      },
      "targetCardinality": {
        "min": 1,
        "max": 1
      }
    },
    {
      "type": "relationship",
      "id": "relation.confirmation.backlog-request.backlog",
      "kind": "references",
      "sourceRef": "confirmation.backlog",
      "targetRef": "request.backlog",
      "label": "待办范围只锁定一次",
      "sourceCardinality": {
        "min": 0,
        "max": 1
      },
      "targetCardinality": {
        "min": 1,
        "max": 1
      }
    },
    {
      "type": "relationship",
      "id": "relation.confirmation.story-request.backlog",
      "kind": "references",
      "sourceRef": "confirmation.story",
      "targetRef": "request.backlog",
      "label": "同一迭代窗口内可追加多笔故事验收",
      "sourceCardinality": {
        "min": 0,
        "max": "many"
      },
      "targetCardinality": {
        "min": 1,
        "max": 1
      }
    },
    {
      "type": "relationship",
      "id": "relation.confirmation.story-confirmation.backlog",
      "kind": "references",
      "sourceRef": "confirmation.story",
      "targetRef": "confirmation.backlog",
      "label": "先锁定迭代基线再验收故事",
      "sourceCardinality": {
        "min": 0,
        "max": 1
      },
      "targetCardinality": {
        "min": 1,
        "max": 1
      }
    },
    {
      "type": "relationship",
      "id": "relation.request.review-contract.iteration-plan",
      "kind": "references",
      "sourceRef": "request.review",
      "targetRef": "contract.iteration-plan",
      "label": "在协议约定范围内发起履约",
      "sourceCardinality": {
        "min": 0,
        "max": 1
      },
      "targetCardinality": {
        "min": 1,
        "max": 1
      }
    },
    {
      "type": "relationship",
      "id": "relation.confirmation.review-request.review",
      "kind": "references",
      "sourceRef": "confirmation.review",
      "targetRef": "request.review",
      "label": "评审结束后形成一份纪要",
      "sourceCardinality": {
        "min": 0,
        "max": 1
      },
      "targetCardinality": {
        "min": 1,
        "max": 1
      }
    }
  ],
  "rules": [
    {
      "type": "rule",
      "id": "rule.request.backlog-deadline",
      "kind": "derivation",
      "label": "待办范围确认请求窗口为 336 小时",
      "description": "待办范围确认请求窗口为 336 小时",
      "contextRef": "context.sprint",
      "bindings": {
        "self": {
          "ref": "request.backlog"
        }
      },
      "expression": "self.started_at + duration(\"336h\")",
      "resultType": "timestamp",
      "target": {
        "entityRef": "request.backlog",
        "attribute": "expired_at"
      }
    },
    {
      "type": "rule",
      "id": "rule.locked-backlog-revision",
      "kind": "derivation",
      "label": "锁定请求中的待办版本",
      "description": "锁定请求中的待办版本",
      "contextRef": "context.sprint",
      "bindings": {
        "backlog": {
          "ref": "request.backlog"
        }
      },
      "expression": "backlog.backlog_revision",
      "resultType": "id",
      "target": {
        "entityRef": "confirmation.backlog",
        "attribute": "backlog_revision"
      }
    },
    {
      "type": "rule",
      "id": "rule.backlog-completed",
      "kind": "completion",
      "label": "锁定后，时窗内验收的不同故事达到约定数量才完成",
      "description": "锁定后，时窗内验收的不同故事达到约定数量才完成",
      "contextRef": "context.sprint",
      "bindings": {
        "backlog": {
          "ref": "request.backlog"
        },
        "baseline": {
          "ref": "confirmation.backlog"
        },
        "stories": {
          "ref": "confirmation.story",
          "cardinality": "many"
        }
      },
      "expression": "size(stories.filter(s, s.confirmed_at >= baseline.confirmed_at && s.confirmed_at <= backlog.expired_at)) == backlog.story_count && stories.all(s, size(stories.filter(t, t.story_id == s.story_id)) == 1)",
      "resultType": "bool"
    },
    {
      "type": "rule",
      "id": "rule.request.review-deadline",
      "kind": "derivation",
      "label": "迭代评审请求窗口为 48 小时",
      "description": "迭代评审请求窗口为 48 小时",
      "contextRef": "context.sprint",
      "bindings": {
        "self": {
          "ref": "request.review"
        }
      },
      "expression": "self.started_at + duration(\"48h\")",
      "resultType": "timestamp",
      "target": {
        "entityRef": "request.review",
        "attribute": "expired_at"
      }
    },
    {
      "type": "rule",
      "id": "rule.request.review-completed",
      "kind": "completion",
      "label": "在评审窗口内确认纪要",
      "description": "在评审窗口内确认纪要",
      "contextRef": "context.sprint",
      "bindings": {
        "request": {
          "ref": "request.review"
        },
        "results": {
          "ref": "confirmation.review",
          "cardinality": "many"
        }
      },
      "expression": "results.exists(c, c.confirmed_at >= request.started_at && c.confirmed_at <= request.expired_at)",
      "resultType": "bool"
    }
  ]
}
