meta {
  name: contract.iteration-plan#sprint-42
  type: http
  seq: 1
}

post {
  url: {{host}}/iteration-plans
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  x-evidence-role: role.product-owner
  x-evidence-asof: {{asOf}}
}

body:json {
  {
    "id": "iteration-42",
    "sprint_goal": "买家可查看订单并导出历史记录"
  }
}

vars:post-response {
  capture_1_1_1: res.body?.id
}

assert {
  res.status: eq 201
  res.body?.id: eq "iteration-42"
  res.body?.signed_at: eq "2026-08-03T09:00:00Z"
}

tests {
  test("$[\"sprint_goal\"]", function () {
    expect(res.body?.sprint_goal).to.equal("买家可查看订单并导出历史记录");
  });
}

settings {
  followRedirects: false
  timeout: 5000
}
