meta {
  name: request.backlog#propose-scope
  type: http
  seq: 2
}

post {
  url: {{host}}/iteration-plans/{{capture_1_1_1}}/backlog
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  x-evidence-role: role.product-owner
  x-evidence-asof: {{asOf_2}}
}

body:json {
  {
    "backlog_revision": "sprint-42-r1",
    "id": "backlog-42",
    "story_count": 2
  }
}

assert {
  res.status: eq 201
  res.body?.backlog_revision: eq "sprint-42-r1"
  res.body?.expired_at: eq "2026-08-17T10:00:00Z"
  res.body?.id: eq "backlog-42"
  res.body?.started_at: eq "2026-08-03T10:00:00Z"
  res.body?.story_count: eq 2
}

settings {
  followRedirects: false
  timeout: 5000
}
