meta {
  name: confirmation.story#accept-01-history
  type: http
  seq: 4
}

post {
  url: {{host}}/iteration-plans/{{capture_1_1_1}}/story-confirmations
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  x-evidence-role: role.product-owner
  x-evidence-asof: {{asOf_4}}
}

body:json {
  {
    "acceptance_note": "买家只看到自己的已签订单",
    "id": "story-proof-52",
    "story_id": "story-52"
  }
}

assert {
  res.status: eq 201
  res.body?.confirmed_at: eq "2026-08-06T10:00:00Z"
  res.body?.id: eq "story-proof-52"
  res.body?.story_id: eq "story-52"
}

tests {
  test("$[\"acceptance_note\"]", function () {
    expect(res.body?.acceptance_note).to.equal("买家只看到自己的已签订单");
  });
}

settings {
  followRedirects: false
  timeout: 5000
}
