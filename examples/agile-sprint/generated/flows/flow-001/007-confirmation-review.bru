meta {
  name: confirmation.review#complete-review
  type: http
  seq: 7
}

post {
  url: {{host}}/iteration-plans/{{capture_1_1_1}}/review/confirmation
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  x-evidence-role: role.product-owner
  x-evidence-asof: {{asOf_7}}
}

body:json {
  {
    "id": "review-minutes-42",
    "outcome": "同意验收结果并归档"
  }
}

assert {
  res.status: eq 201
  res.body?.confirmed_at: eq "2026-08-14T13:00:00Z"
  res.body?.id: eq "review-minutes-42"
}

tests {
  test("$[\"outcome\"]", function () {
    expect(res.body?.outcome).to.equal("同意验收结果并归档");
  });
}

settings {
  followRedirects: false
  timeout: 5000
}
