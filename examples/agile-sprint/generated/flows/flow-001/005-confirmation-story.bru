meta {
  name: confirmation.story#accept-02-export
  type: http
  seq: 5
}

post {
  url: {{host}}/iteration-plans/{{capture_1_1_1}}/story-confirmations
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  x-evidence-role: role.product-owner
  x-evidence-asof: {{asOf_5}}
}

body:json {
  {
    "acceptance_note": "导出文件与页面筛选一致",
    "id": "story-proof-53",
    "story_id": "story-53"
  }
}

assert {
  res.status: eq 201
  res.body?.confirmed_at: eq "2026-08-12T14:00:00Z"
  res.body?.id: eq "story-proof-53"
  res.body?.story_id: eq "story-53"
}

tests {
  test("$[\"acceptance_note\"]", function () {
    expect(res.body?.acceptance_note).to.equal("导出文件与页面筛选一致");
  });
}

settings {
  followRedirects: false
  timeout: 5000
}
