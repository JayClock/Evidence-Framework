meta {
  name: confirmation.backlog#freeze-scope
  type: http
  seq: 3
}

post {
  url: {{host}}/iteration-plans/{{capture_1_1_1}}/backlog/confirmation
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  x-evidence-role: role.development-team
  x-evidence-asof: {{asOf_3}}
}

body:json {
  {
    "id": "locked-42"
  }
}

assert {
  res.status: eq 201
  res.body?.backlog_revision: eq "sprint-42-r1"
  res.body?.confirmed_at: eq "2026-08-03T11:00:00Z"
  res.body?.id: eq "locked-42"
}

settings {
  followRedirects: false
  timeout: 5000
}
