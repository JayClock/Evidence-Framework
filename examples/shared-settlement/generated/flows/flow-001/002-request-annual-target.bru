meta {
  name: request.annual-target#open-year
  type: http
  seq: 2
}

post {
  url: {{host}}/performance-agreements/{{capture_1_1_1}}/annual-target
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  x-evidence-role: role.account-owner
  x-evidence-asof: {{asOf_2}}
}

body:json {
  {
    "id": "target-2026",
    "target_amount_minor": 50000000
  }
}

assert {
  res.status: eq 201
  res.body?.expired_at: eq "2027-01-02T09:00:00Z"
  res.body?.id: eq "target-2026"
  res.body?.started_at: eq "2026-01-02T09:00:00Z"
  res.body?.target_amount_minor: eq 50000000
}

settings {
  followRedirects: false
  timeout: 5000
}
