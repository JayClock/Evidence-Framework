meta {
  name: contract.performance-agreement#sign-fy26
  type: http
  seq: 1
}

post {
  url: {{host}}/performance-agreements
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  x-evidence-role: role.account-owner
  x-evidence-asof: {{asOf}}
}

body:json {
  {
    "fiscal_year": 2026,
    "id": "agreement-fy26"
  }
}

vars:post-response {
  capture_1_1_1: res.body?.id
}

assert {
  res.status: eq 201
  res.body?.fiscal_year: eq 2026
  res.body?.id: eq "agreement-fy26"
  res.body?.signed_at: eq "2026-01-01T09:00:00Z"
}

settings {
  followRedirects: false
  timeout: 5000
}
