meta {
  name: confirmation.revenue#post-revenue-once
  type: http
  seq: 4
}

post {
  url: {{host}}/revenue-confirmations
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  x-evidence-role: role.finance
  x-evidence-asof: {{asOf_4}}
}

body:json {
  {
    "amount_minor": 52000000,
    "booking_ref": "booking-928",
    "id": "revenue-001",
    "request_ids": [
      "target-2026-q1",
      "target-2026"
    ]
  }
}

assert {
  res.status: eq 201
  res.body?.amount_minor: eq 52000000
  res.body?.booking_ref: eq "booking-928"
  res.body?.confirmed_at: eq "2026-03-27T15:00:00Z"
  res.body?.id: eq "revenue-001"
}

tests {
  test("$[\"request_ids\"]", function () {
    expect(res.body?.request_ids).to.deep.equal(JSON.parse("[\"target-2026-q1\",\"target-2026\"]"));
  });
}

settings {
  followRedirects: false
  timeout: 5000
}
