meta {
  name: confirmation.release#single-late-10-confirmed
  type: http
  seq: 20
}

post {
  url: {{host}}/settlements/{{capture_4_16_1}}/releases/{{capture_4_17_1}}/confirmation
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  x-evidence-role: role.settlement-escrow
  x-evidence-asof: {{asOf_9}}
}

body:json {
  {
    "id": "single-late-confirmation-release-10-confirmed"
  }
}

assert {
  res.status: eq 201
  res.body?.confirmed_at: eq "2026-06-30T00:00:00Z"
  res.body?.gross_amount_minor: eq 1354870
  res.body?.id: eq "single-late-confirmation-release-10-confirmed"
  res.body?.late_penalty_minor: eq 203231
  res.body?.payout_minor: eq 1083895
  res.body?.retention_minor: eq 67744
}

settings {
  followRedirects: false
  timeout: 5000
}
