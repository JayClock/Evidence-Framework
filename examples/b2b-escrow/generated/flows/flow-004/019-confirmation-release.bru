meta {
  name: confirmation.release#single-late-01-time-tamper
  type: http
  seq: 19
}

post {
  url: {{host}}/settlements/{{capture_4_16_1}}/releases/{{capture_4_17_1}}/confirmation
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  x-evidence-role: role.settlement-escrow
  x-evidence-asof: {{asOf_9}}
}

body:json {
  {
    "confirmed_at": "2000-01-01T00:00:00Z",
    "id": "single-late-backdated"
  }
}

assert {
  res.status: eq 422
  res.body?.error: eq "INVALID_INPUT"
}

settings {
  followRedirects: false
  timeout: 5000
}
