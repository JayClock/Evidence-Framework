meta {
  name: confirmation.acceptance#single-late
  type: http
  seq: 15
}

post {
  url: {{host}}/fulfillments/{{capture_4_11_1}}/acceptances/{{capture_4_14_1}}/confirmation
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  x-evidence-role: role.fulfillment-buyer
  x-evidence-asof: {{asOf_9}}
}

body:json {
  {
    "accepted": true,
    "id": "single-late-confirmation-acceptance"
  }
}

assert {
  res.status: eq 201
  res.body?.accepted: eq true
  res.body?.accepted_quantity: eq 1000
  res.body?.confirmed_at: eq "2026-06-30T00:00:00Z"
  res.body?.id: eq "single-late-confirmation-acceptance"
  res.body?.late_days: eq 15
}

settings {
  followRedirects: false
  timeout: 5000
}
