meta {
  name: contract.escrow#single-late
  type: http
  seq: 6
}

post {
  url: {{host}}/escrows
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  x-evidence-role: role.escrow-buyer
  x-evidence-asof: {{asOf_4}}
}

body:json {
  {
    "id": "single-late-contract-escrow",
    "order_confirmation_id": "single-late-confirmation-order"
  }
}

vars:post-response {
  capture_4_6_1: res.body?.id
}

assert {
  res.status: eq 201
  res.body?.id: eq "single-late-contract-escrow"
  res.body?.order_confirmation_id: eq "single-late-confirmation-order"
  res.body?.signed_at: eq "2026-06-02T00:00:00Z"
}

settings {
  followRedirects: false
  timeout: 5000
}
