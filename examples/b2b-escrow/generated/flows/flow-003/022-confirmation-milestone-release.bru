meta {
  name: confirmation.milestone-release#milestone-precision-10-confirmed
  type: http
  seq: 22
}

post {
  url: {{host}}/settlements/{{capture_3_18_1}}/milestone-releases/{{capture_3_19_1}}/confirmation
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  x-evidence-role: role.settlement-escrow
  x-evidence-asof: {{asOf_11}}
}

body:json {
  {
    "id": "milestone-precision-confirmation-milestone-release-10-confirmed"
  }
}

assert {
  res.status: eq 201
  res.body?.confirmed_at: eq "2026-06-15T00:00:01Z"
  res.body?.gross_amount_minor: eq "22600000000000002"
  res.body?.id: eq "milestone-precision-confirmation-milestone-release-10-confirmed"
