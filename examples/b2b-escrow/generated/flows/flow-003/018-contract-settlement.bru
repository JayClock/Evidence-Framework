meta {
  name: contract.settlement#milestone-precision
  type: http
  seq: 18
}

post {
  url: {{host}}/settlements
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  x-evidence-role: role.settlement-seller
  x-evidence-asof: {{asOf_11}}
}

body:json {
  {
    "acceptance_confirmation_id": "milestone-precision-confirmation-milestone-acceptance",
    "deposit_confirmation_id": "milestone-precision-confirmation-deposit-lock",
    "id": "milestone-precision-contract-settlement",
    "order_confirmation_id": "milestone-precision-confirmation-order"
  }
}

vars:post-response {
  capture_3_18_1: res.body?.id
}

assert {
  res.status: eq 201
  res.body?.acceptance_confirmation_id: eq "milestone-precision-confirmation-milestone-acceptance"
  res.body?.deposit_confirmation_id: eq "milestone-precision-confirmation-deposit-lock"
  res.body?.id: eq "milestone-precision-contract-settlement"
  res.body?.order_confirmation_id: eq "milestone-precision-confirmation-order"
  res.body?.signed_at: eq "2026-06-15T00:00:01Z"
}

settings {
  followRedirects: false
  timeout: 5000
}
