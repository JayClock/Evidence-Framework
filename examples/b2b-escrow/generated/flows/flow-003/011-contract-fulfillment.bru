meta {
  name: contract.fulfillment#milestone-precision
  type: http
  seq: 11
}

post {
  url: {{host}}/fulfillments
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  x-evidence-role: role.fulfillment-buyer
  x-evidence-asof: {{asOf_7}}
}

body:json {
  {
    "deposit_confirmation_id": "milestone-precision-confirmation-deposit-lock",
    "id": "milestone-precision-contract-fulfillment",
    "order_confirmation_id": "milestone-precision-confirmation-order"
  }
}

vars:post-response {
  capture_3_11_1: res.body?.id
}

assert {
  res.status: eq 201
  res.body?.deposit_confirmation_id: eq "milestone-precision-confirmation-deposit-lock"
  res.body?.id: eq "milestone-precision-contract-fulfillment"
  res.body?.order_confirmation_id: eq "milestone-precision-confirmation-order"
  res.body?.signed_at: eq "2026-06-03T00:00:00Z"
}

settings {
  followRedirects: false
  timeout: 5000
}
