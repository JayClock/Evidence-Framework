meta {
  name: confirmation.custody-statement#milestone-precision
  type: http
  seq: 10
}

post {
  url: {{host}}/escrows/{{capture_3_6_1}}/custody-statements/{{capture_3_9_1}}/confirmation
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  x-evidence-role: role.escrow-buyer
  x-evidence-asof: {{asOf_6}}
}

body:json {
  {
    "acknowledged": true,
    "id": "milestone-precision-confirmation-custody-statement"
  }
}

assert {
  res.status: eq 201
  res.body?.acknowledged: eq true
  res.body?.confirmed_at: eq "2026-06-02T00:02:00Z"
  res.body?.id: eq "milestone-precision-confirmation-custody-statement"
}

settings {
  followRedirects: false
  timeout: 5000
}
