meta {
  name: confirmation.milestone-acceptance#milestone-precision
  type: http
  seq: 17
}

post {
  url: {{host}}/fulfillments/{{capture_3_11_1}}/milestone-acceptances/{{capture_3_16_1}}/confirmation
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  x-evidence-role: role.fulfillment-buyer
  x-evidence-asof: {{asOf_11}}
}

body:json {
  {
    "accepted": true,
    "id": "milestone-precision-confirmation-milestone-acceptance"
  }
}

assert {
  res.status: eq 201
  res.body?.accepted: eq true
  res.body?.accepted_quantity: eq 2
  res.body?.confirmed_at: eq "2026-06-15T00:00:01Z"
  res.body?.id: eq "milestone-precision-confirmation-milestone-acceptance"
  res.body?.late_days: eq 1
}

settings {
  followRedirects: false
  timeout: 5000
}
