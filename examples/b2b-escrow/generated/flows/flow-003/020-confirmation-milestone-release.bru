meta {
  name: confirmation.milestone-release#milestone-precision-00-tamper
  type: http
  seq: 20
}

post {
  url: {{host}}/settlements/{{capture_3_18_1}}/milestone-releases/{{capture_3_19_1}}/confirmation
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  x-evidence-role: role.settlement-escrow
  x-evidence-asof: {{asOf_11}}
}

body:json {
  {
    "id": "milestone-precision-forged",
    "payout_minor": 999999
  }
}

assert {
  res.status: eq 422
  res.body?.error: eq "INVALID_INPUT"
}

settings {
  followRedirects: false
  timeout: 5000
}
