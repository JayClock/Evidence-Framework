meta {
  name: confirmation.release#single-on-time-10-confirmed
  type: http
  seq: 20
}

post {
  url: {{host}}/settlements/{{capture_5_16_1}}/releases/{{capture_5_17_1}}/confirmation
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  x-evidence-role: role.settlement-escrow
  x-evidence-asof: {{asOf_10}}
}

body:json {
  {
    "id": "single-on-time-confirmation-release-10-confirmed"
  }
}

assert {
  res.status: eq 201
  res.body?.confirmed_at: eq "2026-06-15T00:00:00Z"
  res.body?.gross_amount_minor: eq 1466402
  res.body?.id: eq "single-on-time-confirmation-release-10-confirmed"
  res.body?.late_penalty_minor: eq 0
  res.body?.payout_minor: eq 1393082
  res.body?.retention_minor: eq 73320
}

settings {
  followRedirects: false
  timeout: 5000
}
