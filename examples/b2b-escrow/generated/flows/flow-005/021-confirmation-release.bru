meta {
  name: confirmation.release#single-on-time-20-duplicate
  type: http
  seq: 21
}

post {
  url: {{host}}/settlements/{{capture_5_16_1}}/releases/{{capture_5_17_1}}/confirmation
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  x-evidence-role: role.settlement-escrow
  x-evidence-asof: {{asOf_10}}
}

body:json {
  {
    "id": "single-on-time-duplicate"
  }
}

assert {
  res.status: eq 409
  res.body?.error: eq "ALREADY_CONFIRMED"
}

settings {
  followRedirects: false
  timeout: 5000
}
