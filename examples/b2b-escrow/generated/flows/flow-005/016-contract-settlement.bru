meta {
  name: contract.settlement#single-on-time
  type: http
  seq: 16
}

post {
  url: {{host}}/settlements
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  x-evidence-role: role.settlement-seller
  x-evidence-asof: {{asOf_10}}
}

body:json {
  {
    "acceptance_confirmation_id": "single-on-time-confirmation-acceptance",
    "deposit_confirmation_id": "single-on-time-confirmation-deposit-lock",
    "id": "single-on-time-contract-settlement",
    "order_confirmation_id": "single-on-time-confirmation-order"
  }
}

vars:post-response {
  capture_5_16_1: res.body?.id
}

assert {
  res.status: eq 201
  res.body?.acceptance_confirmation_id: eq "single-on-time-confirmation-acceptance"
  res.body?.deposit_confirmation_id: eq "single-on-time-confirmation-deposit-lock"
  res.body?.id: eq "single-on-time-contract-settlement"
  res.body?.order_confirmation_id: eq "single-on-time-confirmation-order"
  res.body?.signed_at: eq "2026-06-15T00:00:00Z"
}

settings {
  followRedirects: false
  timeout: 5000
}
