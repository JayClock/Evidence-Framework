meta {
  name: confirmation.first-milestone#milestone-capped
  type: http
  seq: 13
}

post {
  url: {{host}}/fulfillments/{{capture_1_11_1}}/first-milestones/{{capture_1_12_1}}/confirmation
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  x-evidence-role: role.fulfillment-seller
  x-evidence-asof: {{asOf_8}}
}

body:json {
  {
    "delivered_quantity": 500,
    "id": "milestone-capped-confirmation-first-milestone"
  }
}

assert {
  res.status: eq 201
  res.body?.confirmed_at: eq "2026-06-10T00:00:00Z"
  res.body?.delivered_quantity: eq 500
  res.body?.id: eq "milestone-capped-confirmation-first-milestone"
}

settings {
  followRedirects: false
  timeout: 5000
}
