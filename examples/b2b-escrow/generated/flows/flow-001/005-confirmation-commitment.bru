meta {
  name: confirmation.commitment#milestone-capped
  type: http
  seq: 5
}

post {
  url: {{host}}/agreements/{{capture_1_1_1}}/commitments/{{capture_1_4_1}}/confirmation
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  x-evidence-role: role.procurement-buyer
  x-evidence-asof: {{asOf_3}}
}

body:json {
  {
    "acknowledged": true,
    "id": "milestone-capped-confirmation-commitment"
  }
}

assert {
  res.status: eq 201
  res.body?.acknowledged: eq true
  res.body?.confirmed_at: eq "2026-06-01T00:02:00Z"
  res.body?.id: eq "milestone-capped-confirmation-commitment"
}

settings {
  followRedirects: false
  timeout: 5000
}
