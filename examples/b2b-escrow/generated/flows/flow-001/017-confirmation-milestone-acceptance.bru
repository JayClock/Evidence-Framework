meta {
  name: confirmation.milestone-acceptance#milestone-capped
  type: http
  seq: 17
}

post {
  url: {{host}}/fulfillments/{{capture_1_11_1}}/milestone-acceptances/{{capture_1_16_1}}/confirmation
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  x-evidence-role: role.fulfillment-buyer
  x-evidence-asof: {{asOf_9}}
}

body:json {
  {
    "accepted": true,
    "id": "milestone-capped-confirmation-milestone-acceptance"
  }
}

assert {
  res.status: eq 201
  res.body?.accepted: eq true
  res.body?.accepted_quantity: eq 1001
  res.body?.confirmed_at: eq "2026-06-30T00:00:00Z"
  res.body?.id: eq "milestone-capped-confirmation-milestone-acceptance"
  res.body?.late_days: eq 15
}

settings {
  followRedirects: false
  timeout: 5000
}
