meta {
  name: confirmation.milestone-release#milestone-capped-10-confirmed
  type: http
  seq: 22
}

post {
  url: {{host}}/settlements/{{capture_1_18_1}}/milestone-releases/{{capture_1_19_1}}/confirmation
  body: json
  auth: none
}

headers {
  Content-Type: application/json
