meta {
  name: confirmation.final-milestone#milestone-capped
  type: http
  seq: 15
}

post {
  url: {{host}}/fulfillments/{{capture_1_11_1}}/final-milestones/{{capture_1_14_1}}/confirmation
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  x-evidence-role: role.fulfillment-seller
  x-evidence-asof: {{asOf_9}}
}

body:json {
  {
    "delivered_quantity": 501,
    "id": "milestone-capped-confirmation-final-milestone"
  }
}

assert {
  res.status: eq 201
  res.body?.confirmed_at: eq "2026-06-30T00:00:00Z"
  res.body?.delivered_quantity: eq 501
  res.body?.id: eq "milestone-capped-confirmation-final-milestone"
}

settings {
  followRedirects: false
  timeout: 5000
}
