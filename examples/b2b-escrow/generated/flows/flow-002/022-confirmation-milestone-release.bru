meta {
  name: confirmation.milestone-release#milestone-on-time-10-confirmed
  type: http
  seq: 22
}

post {
  url: {{host}}/settlements/{{capture_2_18_1}}/milestone-releases/{{capture_2_19_1}}/confirmation
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  x-evidence-role: role.settlement-escrow
  x-evidence-asof: {{asOf_10}}
}

body:json {
  {
    "id": "milestone-on-time-confirmation-milestone-release-10-confirmed"
  }
}

assert {
  res.status: eq 201
  res.body?.confirmed_at: eq "2026-06-15T00:00:00Z"
  res.body?.gross_amount_minor: eq 1354870
  res.body?.id: eq "milestone-on-time-confirmation-milestone-release-10-confirmed"
  res.body?.late_penalty_minor: eq 0
  res.body?.payout_minor: eq 1287126
