meta {
  name: confirmation.milestone-release#milestone-on-time-01-time-tamper
  type: http
  seq: 21
}

post {
  url: {{host}}/settlements/{{capture_2_18_1}}/milestone-releases/{{capture_2_19_1}}/confirmation
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  x-evidence-role: role.settlement-escrow
  x-evidence-asof: {{asOf_10}}
}

body:json {
  {
    "confirmed_at": "2000-01-01T00:00:00Z",
    "id": "milestone-on-time-backdated"
  }
}

assert {
  res.status: eq 422
  res.body?.error: eq "INVALID_INPUT"
}

settings {
  followRedirects: false
  timeout: 5000
}
