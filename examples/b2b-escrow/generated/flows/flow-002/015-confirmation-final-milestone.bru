meta {
  name: confirmation.final-milestone#milestone-on-time
  type: http
  seq: 15
}

post {
  url: {{host}}/fulfillments/{{capture_2_11_1}}/final-milestones/{{capture_2_14_1}}/confirmation
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  x-evidence-role: role.fulfillment-seller
  x-evidence-asof: {{asOf_10}}
}

body:json {
  {
    "delivered_quantity": 500,
    "id": "milestone-on-time-confirmation-final-milestone"
  }
}

assert {
  res.status: eq 201
  res.body?.confirmed_at: eq "2026-06-15T00:00:00Z"
  res.body?.delivered_quantity: eq 500
  res.body?.id: eq "milestone-on-time-confirmation-final-milestone"
}

settings {
  followRedirects: false
  timeout: 5000
}
