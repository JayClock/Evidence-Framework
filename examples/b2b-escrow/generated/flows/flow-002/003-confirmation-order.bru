meta {
  name: confirmation.order#milestone-on-time
  type: http
  seq: 3
}

post {
  url: {{host}}/agreements/{{capture_2_1_1}}/orders/{{capture_2_2_1}}/confirmation
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  x-evidence-role: role.procurement-seller
  x-evidence-asof: {{asOf_2}}
}

body:json {
  {
    "id": "milestone-on-time-confirmation-order"
  }
}

assert {
  res.status: eq 201
  res.body?.confirmed_at: eq "2026-06-01T00:01:00Z"
  res.body?.daily_penalty_bps: eq 100
  res.body?.delivery_deadline: eq "2026-06-15T00:00:00Z"
  res.body?.gross_amount_minor: eq 1354870
  res.body?.id: eq "milestone-on-time-confirmation-order"
  res.body?.quantity: eq 1000
  res.body?.retention_bps: eq 500
  res.body?.subtotal_minor: eq 1199000
}

settings {
  followRedirects: false
  timeout: 5000
}
