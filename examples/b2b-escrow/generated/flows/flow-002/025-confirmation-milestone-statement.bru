meta {
  name: confirmation.milestone-statement#milestone-on-time
  type: http
  seq: 25
}

post {
  url: {{host}}/settlements/{{capture_2_18_1}}/milestone-statements/{{capture_2_24_1}}/confirmation
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  x-evidence-role: role.settlement-seller
  x-evidence-asof: {{asOf_10}}
}

body:json {
  {
    "acknowledged": true,
    "id": "milestone-on-time-confirmation-milestone-statement"
  }
}

assert {
  res.status: eq 201
  res.body?.acknowledged: eq true
  res.body?.confirmed_at: eq "2026-06-15T00:00:00Z"
  res.body?.id: eq "milestone-on-time-confirmation-milestone-statement"
}

settings {
  followRedirects: false
  timeout: 5000
}
