    {
      "id": "term.completed",
      "kind": "standalone",
      "name": "完成",
      "definition": "具体证据满足该请求的完成规则；不是单据登记成功的同义词",
      "sourceRefs": [
        "git:9bf113b791363a2155598ff62a9366f08673433e:.evidence/fm/01-glossary.md#L32"
      ]
