{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jayclock.dev/fm/v2/model.schema.json",
  "title": "Fulfillment Modeling manifest",
  "type": "object",
  "required": [
    "type",
    "schemaVersion",
    "id",
    "name",
    "version",
    "ruleLanguage",
    "entryContextRefs"
  ],
  "properties": {
    "type": { "const": "fm_model" },
    "schemaVersion": { "const": "2.0" },
    "id": { "$ref": "#/$defs/id" },
    "name": { "type": "string", "minLength": 1 },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "ruleLanguage": { "const": "CEL" },
    "entryContextRefs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/id" },
      "uniqueItems": true
    },
    "description": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false,
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
    }
  }
}
