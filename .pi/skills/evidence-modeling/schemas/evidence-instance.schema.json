{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jayclock.dev/fm/v2/evidence-instance.schema.json",
  "title": "FM evidence document instance",
  "type": "object",
  "required": ["type", "id", "entityRef", "values"],
  "properties": {
    "type": { "const": "evidence_instance" },
    "id": { "$ref": "#/$defs/id" },
    "entityRef": { "$ref": "#/$defs/id" },
    "values": {
      "type": "object",
      "additionalProperties": true
    },
    "basedOn": {
      "type": "array",
      "items": { "$ref": "#/$defs/id" },
      "uniqueItems": true
    },
    "notes": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false,
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
    }
  }
}
