{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jayclock.dev/fm/v3/compiled-model.schema.json",
  "title": "Compiled Fulfillment Modeling document",
  "type": "object",
  "required": [
    "schemaVersion",
    "model",
    "entities",
    "fulfillments",
    "relationships",
    "rules",
    "businessPatterns"
  ],
  "properties": {
    "schemaVersion": { "const": "3.0" },
    "model": { "$ref": "model.schema.json" },
    "entities": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "entity.schema.json" }
    },
    "fulfillments": {
      "description": "Empty when the modeled scope has no Fulfillment; existing Fulfillments retain all v3 constraints.",
      "type": "array",
      "items": { "$ref": "fulfillment.schema.json" }
    },
    "relationships": {
      "type": "array",
      "items": { "$ref": "relationship.schema.json" }
    },
    "rules": {
      "type": "array",
      "items": { "$ref": "rule.schema.json" }
    },
    "businessPatterns": {
      "type": "array",
      "items": { "$ref": "business-pattern.schema.json" }
    }
  },
  "additionalProperties": false
}
