    {
      "id": "claim_d69b4a3b54db4f69a4cfa0a7b8a8e9d4",
      "statement": "A model command is a deterministic transition that never mutates its input: it returns the next document, the inverse command, the affected ids and a result, and the session stores the forward/inverse pair as one history entry.",
