    {
      "id": "claim_1c1a5ca3d52e4aa88d961f0038efdab9",
      "statement": "The ingestion prompt encodes a seven-step reading discipline — split the document into business, domain and legal clauses, find the contract, split the pre-contract context, pair request spans with confirmation instants, read a breach as a new fulfillment pair, separate the thing into the domain context, and extract computed values as calculator or checker things — plus hard constraints against inventing facts, missing provenance, rewriting a legal clause into an obligation, more than two contract roles, using a span as a confirmation, and any output other than JSON.",
      "evidence": [
        {
          "resource": "repo://libs/evidence-agent/src/prompts/ingestion.ts#L14-L70",
          "version": "repo-lines-v1:sha256:6dc5235113e9db2f9f7f17603c47082dcf7c2d0f6e345feda42480e5c7ee0a81:"
        }
      ]
    },
