    {
      "id": "claim_e3a4221b6e4b4fe0810db699154f2e50",
      "statement": "A pre-contract Context yields `open` and `read` routes per enquiry plus a `propose` route per proposal, nested under the enquiry only when a `references` relationship ties them and otherwise left at the lane root; a Domain Context yields only `GET` read routes for its `participant`/`thing` objects, because a domain answer is read and never written by a caller.",
      "evidence": [
        {
          "resource": "repo://libs/evidence-api/src/delivery/routes.ts#L368-L493",
