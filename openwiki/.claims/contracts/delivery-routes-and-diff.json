        }
      ]
    },
    {
      "id": "claim_f9cbb103275c433891de404c31a5f191",
      "statement": "A service's kind is decided by capability first and Context kind second: a Context that answers another Context's evidence-kind socket is `capability`, otherwise `pre_contract` becomes `channel`, `domain` becomes `domain`, and every remaining Context becomes `fulfillment`.",
      "evidence": [
        {
          "resource": "repo://libs/evidence-api/src/delivery/topology.ts#L225-L268",
          "version": "repo-lines-v1:sha256:c2dd1918e4030d4e553e43ee5998ade3ed68fe88c65d2752f49c012de6e235bd:"
