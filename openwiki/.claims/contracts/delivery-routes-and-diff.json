        }
      ]
    },
    {
      "id": "claim_3e2fcec783ed4b27a76d7a7fd8b21872",
      "statement": "Capability sockets are never declared twice: a `plays_role` relationship whose target is a `role` of kind `evidence` in a different Context makes the player's Context the supplier, filling `supplies` on the supplier, `consumes` on the consumer, and emitting a `link.capability.*` link with `mode: 'async'` because the confirmation arrives from the supplier's own clock as a callback.",
      "evidence": [
        {
          "resource": "repo://libs/evidence-api/src/delivery/topology.ts#L240-L285",
          "version": "repo-lines-v1:sha256:0355855be4ec17122ab05f5bf8569e02f279c8ef91fb4347c10fc90b57285bbf:"
