    {
      "id": "claim_996603e15b324bad86d9e0548e979eb9",
      "statement": "Each fulfillment pair yields a `POST` request route, a `GET` ledger route and one `POST` confirm route per confirmation, with 201 and 409 on request, 200 and 404 on ledger and 201, 409 and 422 on confirm; a contract Context's root contract additionally gets a `POST` sign route (201, 422) and a `GET` read route (200, 404).",
      "evidence": [
        {
          "resource": "repo://libs/evidence-api/src/delivery/routes.ts#L203-L363",
          "version": "repo-lines-v1:sha256:1bb4ae80c69739799ec17b014f8119867a73b54bcf055171442b4b20e09d8a1d:"
