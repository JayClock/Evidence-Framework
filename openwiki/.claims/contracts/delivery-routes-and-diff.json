        {
          "resource": "repo://libs/evidence-api/src/delivery/segments.ts#L18-L83",
          "version": "repo-lines-v1:sha256:c88639f1a49a99db39ccd60679f98c175933f3da70f87486632594bece7f472f:"
        },
        {
