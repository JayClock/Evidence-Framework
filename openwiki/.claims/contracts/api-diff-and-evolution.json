        {
          "resource": "repo://libs/evidence-api/src/diff/apiDiff.spec.ts#L162-L170",
          "version": "repo-lines-v1:sha256:de2cbe56321198dcda410d88284bd06f644b907896cd33ce6757b5a952f62111:"
