        {
          "resource": "repo://libs/evidence-mcp/src/bridge/endpoint.ts#L13-L33",
          "version": "repo-lines-v1:sha256:8a6099885771162cd26a9ceb7e31d923b2f856c9931961817919f755ba812e70:"
        }
      ]
    },
    {
      "id": "claim_a57ba4bd76d64d088c243aa11d9a307e",
      "statement": "On Unix the bridge unlinks a stale endpoint before listening and narrows the socket to 0600 after listen succeeds, while named pipes skip both steps; each connection carries one newline-delimited JSON request and response, capped at 64 MiB and correlated by a caller-supplied id.",
