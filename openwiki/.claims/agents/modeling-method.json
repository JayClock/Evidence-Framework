    {
      "id": "claim_823abc360f534893a2927bd78fe61219",
      "statement": "The seven workshop steps live in evidence-schema as the WORKSHOP_STEPS tuple of {id, label, hint} records with ids anchor-contract, pair-fulfillment, name-things, invert-dependency, close-breach, trace-key-data and connect-flow; they are shared vocabulary only, and nothing on disk, in the model, in the session or in Pi records a current step.",
      "evidence": [
        {
          "resource": "repo://libs/evidence-schema/src/ast/workshop.ts#L1-L52",
          "version": "repo-lines-v1:sha256:a5506dbaba9815bc3765d25a26c4b3c7cf80d58f3cc6318a03c4c16a6072112b:"
        }
      ]
    },
    {
      "id": "claim_d5afe1a9f644465b90ca5162bd229081",
      "statement": "The step order is deliberate: contract before its obligations, obligations before the things they trade in, things before the computations over them, happy path before its failures, and key data after the failure path because most amounts only become decidable once the compensation route is known.",
      "evidence": [
        {
          "resource": "repo://libs/evidence-schema/src/ast/workshop.ts#L11-L14",
          "version": "repo-lines-v1:sha256:04c52a496f6a971f3cfcf2af4c159f139b5cd7654e2e0ca182714834c4ac6cd8:"
        }
