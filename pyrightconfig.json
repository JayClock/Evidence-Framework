{
  "include": [".agents/skills", "tests/skills"],
  "exclude": ["**/__pycache__", "**/.ruff_cache"],
  "venvPath": "node_modules/.cache",
  "venv": "evidence-fm-runtime",
  "executionEnvironments": [
    {
      "root": ".agents/skills/evidence-fm/tests",
      "extraPaths": [
        ".agents/skills/evidence-fm/scripts",
        ".agents/skills/evidence-fm/tests",
        ".agents/skills/evidence-fm/evals"
      ]
    },
    {
      "root": ".agents/skills/evidence-fm/evals",
      "extraPaths": [".agents/skills/evidence-fm/scripts"]
    },
    {
      "root": ".agents/skills/evidence-fm/scripts",
      "extraPaths": [".agents/skills/evidence-fm/scripts"]
    },
    { "root": "tests/skills" }
  ]
}
