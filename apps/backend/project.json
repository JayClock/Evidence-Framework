{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "backend",
  "projectType": "application",
  "sourceRoot": "apps/backend/src",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": [],
      "parallelism": false,
      "cache": true,
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/build.gradle",
        "{workspaceRoot}/settings.gradle",
        "{workspaceRoot}/gradle.properties",
        "{workspaceRoot}/gradle/**/*",
        "{workspaceRoot}/gradlew"
      ],
      "outputs": ["{projectRoot}/build"],
      "options": {
        "command": "./gradlew :backend:build --console=plain"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "command": "./gradlew :backend:bootRun --console=plain"
      }
    }
  },
  "tags": ["type:app", "scope:backend"]
}
