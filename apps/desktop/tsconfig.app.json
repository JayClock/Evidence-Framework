{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "emitDeclarationOnly": false,
    "declarationMap": false,
    "noEmit": true,
    "jsx": "react-jsx",
    "lib": ["dom", "dom.iterable", "es2023"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["node", "vite/client"],
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "client/**/*.ts",
    "renderer/**/*.ts",
    "renderer/**/*.tsx",
    "shared/**/*.ts",
    "forge.env.d.ts"
  ],
  "references": [
    {
      "path": "../../packages/evidence-canvas-interaction/tsconfig.lib.json"
    },
    {
      "path": "../../packages/evidence-model-core/tsconfig.lib.json"
    },
    {
      "path": "../../packages/evidence-schema/tsconfig.lib.json"
    },
    {
      "path": "../../packages/evidence-agent-core/tsconfig.lib.json"
    },
    {
      "path": "../../packages/evidence-modeling-orchestrator/tsconfig.lib.json"
    }
  ]
}
