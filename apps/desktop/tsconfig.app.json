{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "emitDeclarationOnly": false,
    "declarationMap": false,
    "noEmit": true,
    "jsx": "react-jsx",
    "lib": ["dom", "dom.iterable", "es2023"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["node", "vite/client"],
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "src/main/**/*.ts",
    "src/preload/**/*.ts",
    "src/renderer/**/*.ts",
    "src/renderer/**/*.tsx",
    "src/shared/**/*.ts",
    "forge.env.d.ts"
  ],
  "references": [
    {
      "path": "../../libs/evidence-canvas-interaction/tsconfig.lib.json"
    },
    {
      "path": "../../libs/evidence-model-core/tsconfig.lib.json"
    },
    {
      "path": "../../libs/evidence-schema/tsconfig.lib.json"
    },
    {
      "path": "../../libs/evidence-mcp/tsconfig.lib.json"
    },
    {
      "path": "../../libs/evidence-agent-core/tsconfig.lib.json"
    },
    {
      "path": "../../libs/evidence-modeling-orchestrator/tsconfig.lib.json"
    }
  ]
}
