{
  "type": "rule",
  "id": "rule.payment-expired",
  "kind": "breach",
  "label": "付款逾期",
  "description": "当前时间超过内容产品付款请求（Content Payment Request）[request.content-payment]的截止时间且尚无内容产品付款确认（Content Payment Confirmation）[confirmation.content-payment]时，判定该请求逾期。",
  "contextRef": "context.content-subscription",
  "bindings": {
    "request": {
      "ref": "request.content-payment"
    },
    "paymentConfirmed": {
      "type": "bool"
    },
    "now": {
      "type": "timestamp"
    }
  },
  "expression": "now > request.expired_at && !paymentConfirmed",
  "resultType": "bool",
  "fulfillmentRef": "fulfillment.content-payment"
}
