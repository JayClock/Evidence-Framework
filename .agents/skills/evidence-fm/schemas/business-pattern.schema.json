{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jayclock.dev/fm/v3/business-pattern.schema.json",
  "title": "Fulfillment Modeling reusable business pattern",
  "type": "object",
  "required": [
    "type",
    "id",
    "label",
    "businessGoals",
    "operationInvariant",
    "domainNeutralClaim",
    "businessSpineRefs",
    "variationPointRefs",
    "domainInputRefs",
    "supportedByContractContextRefs",
    "domainExampleContextRefs"
  ],
  "properties": {
    "type": { "const": "business_pattern" },
    "id": { "$ref": "#/$defs/id" },
    "label": { "type": "string", "minLength": 1 },
    "businessGoals": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["revenue", "cost", "kpi", "compliance", "risk"] }
    },
    "operationInvariant": { "type": "string", "minLength": 1 },
    "domainNeutralClaim": { "type": "string", "minLength": 1 },
    "businessSpineRefs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "invariantRefs": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "variationPointRefs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "domainInputRefs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "supportedByContractContextRefs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "domainExampleContextRefs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "notes": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false,
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
    }
  }
}
