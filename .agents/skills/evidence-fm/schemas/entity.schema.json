{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jayclock.dev/fm/v3/entity.schema.json",
  "title": "Fulfillment Modeling entity",
  "type": "object",
  "required": ["type", "id", "category", "kind", "label"],
  "properties": {
    "type": { "const": "entity" },
    "id": { "$ref": "#/$defs/id" },
    "category": { "enum": ["evidence", "participant", "role", "context"] },
    "kind": { "type": "string", "minLength": 1 },
    "label": { "type": "string", "minLength": 1 },
    "aliases": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "contextRef": { "$ref": "#/$defs/id" },
    "parentContextRef": { "$ref": "#/$defs/id" },
    "rootRefs": {
      "type": "array",
      "items": { "$ref": "#/$defs/id" },
      "minItems": 1,
      "uniqueItems": true
    },
    "responsibleRoleRef": { "$ref": "#/$defs/id" },
    "roleRefs": {
      "description": "For Contract evidence, exactly two contextual Party Role IDs; explicit Participant players are optional.",
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "$ref": "#/$defs/id" },
      "uniqueItems": true
    },
    "attributes": {
      "type": "array",
      "items": { "$ref": "#/$defs/attribute" }
    },
    "notes": { "type": "string", "minLength": 1 }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "category": { "const": "evidence" },
          "kind": { "enum": ["rfp", "proposal", "fulfillment_request"] }
        },
        "required": ["category", "kind"]
      },
      "then": {
        "required": ["attributes"],
        "properties": {
          "attributes": {
            "allOf": [
              {
                "contains": {
                  "allOf": [
                    { "$ref": "#/$defs/evidenceTime" },
                    { "properties": { "name": { "const": "started_at" } } }
                  ]
                },
                "minContains": 1,
                "maxContains": 1
              },
              {
                "contains": {
                  "allOf": [
                    { "$ref": "#/$defs/evidenceTime" },
                    { "properties": { "name": { "const": "expired_at" } } }
                  ]
                },
                "minContains": 1,
                "maxContains": 1
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "category": { "const": "evidence" },
          "kind": { "const": "contract" }
        },
        "required": ["category", "kind"]
      },
      "then": {
        "required": ["attributes"],
        "properties": {
          "attributes": {
            "contains": {
              "allOf": [
                { "$ref": "#/$defs/evidenceTime" },
                { "properties": { "name": { "const": "signed_at" } } }
              ]
            },
            "minContains": 1,
            "maxContains": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "category": { "const": "evidence" },
          "kind": { "const": "fulfillment_confirmation" }
        },
        "required": ["category", "kind"]
      },
      "then": {
        "required": ["attributes"],
        "properties": {
          "attributes": {
            "contains": {
              "allOf": [
                { "$ref": "#/$defs/evidenceTime" },
                { "properties": { "name": { "const": "confirmed_at" } } }
              ]
            },
            "minContains": 1,
            "maxContains": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "category": { "const": "evidence" },
          "kind": { "const": "other_evidence" }
        },
        "required": ["category", "kind"]
      },
      "then": {
        "required": ["attributes"],
        "properties": {
          "attributes": {
            "contains": {
              "allOf": [
                { "$ref": "#/$defs/evidenceTime" },
                { "properties": { "name": { "const": "created_at" } } }
              ]
            },
            "minContains": 1,
            "maxContains": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": { "category": { "const": "evidence" } },
        "required": ["category"]
      },
      "then": {
        "properties": {
          "kind": {
            "enum": [
              "rfp",
              "proposal",
              "contract",
              "fulfillment_request",
              "fulfillment_confirmation",
              "other_evidence"
            ]
          }
        },
        "required": ["contextRef"]
      }
    },
    {
      "if": {
        "properties": {
          "category": { "const": "evidence" },
          "kind": {
            "enum": [
              "rfp",
              "proposal",
              "fulfillment_request",
              "fulfillment_confirmation",
              "other_evidence"
            ]
          }
        },
        "required": ["category", "kind"]
      },
      "then": { "required": ["responsibleRoleRef"] }
    },
    {
      "if": {
        "properties": {
          "category": { "const": "evidence" },
          "kind": { "const": "contract" }
        },
        "required": ["category", "kind"]
      },
      "then": { "required": ["roleRefs"] }
    },
    {
      "if": {
        "properties": { "category": { "const": "participant" } },
        "required": ["category"]
      },
      "then": {
        "properties": { "kind": { "enum": ["party", "thing"] } }
      }
    },
    {
      "if": {
        "properties": {
          "category": { "const": "participant" },
          "kind": { "const": "thing" }
        },
        "required": ["category", "kind"]
      },
      "then": { "required": ["contextRef"] }
    },
    {
      "if": {
        "properties": { "category": { "const": "role" } },
        "required": ["category"]
      },
      "then": {
        "properties": {
          "kind": {
            "enum": ["party", "domain", "third_party", "context", "evidence"]
          }
        },
        "required": ["contextRef"]
      }
    },
    {
      "if": {
        "properties": { "category": { "const": "context" } },
        "required": ["category"]
      },
      "then": {
        "properties": {
          "kind": {
            "enum": [
              "contract",
              "fulfillment",
              "pre_contract",
              "channel",
              "domain",
              "external"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "category": { "const": "context" },
          "kind": { "const": "fulfillment" }
        },
        "required": ["category", "kind"]
      },
      "then": { "required": ["parentContextRef"] }
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "evidenceTime": {
      "type": "object",
      "required": ["name", "valueType", "required", "keyData"],
      "properties": {
        "valueType": { "const": "timestamp" },
        "required": { "const": true },
        "keyData": { "const": true }
      }
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
    },
    "attribute": {
      "type": "object",
      "required": ["name", "label", "valueType", "required", "meaning"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
        },
        "label": { "type": "string", "minLength": 1 },
        "valueType": {
          "enum": [
            "bool",
            "int",
            "uint",
            "double",
            "decimal",
            "string",
            "bytes",
            "timestamp",
            "duration",
            "date",
            "money",
            "enum",
            "id",
            "list",
            "map",
            "dynamic"
          ]
        },
        "required": { "type": "boolean" },
        "keyData": {
          "description": "Marks a financially, temporally, quantitatively, or audit-significant value for lineage reporting.",
          "type": "boolean"
        },
        "meaning": { "type": "string", "minLength": 1 },
        "derivedByRuleRef": { "$ref": "#/$defs/id" },
        "notes": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  }
}
