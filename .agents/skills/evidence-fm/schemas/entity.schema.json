{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jayclock.dev/fm/v3/entity.schema.json",
  "title": "Fulfillment Modeling entity",
  "type": "object",
  "required": ["type", "id", "category", "kind", "label"],
  "properties": {
    "type": {
      "const": "entity"
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "category": {
      "enum": ["evidence", "participant", "role", "context"]
    },
    "kind": {
      "type": "string",
      "minLength": 1
    },
    "label": {
      "type": "string",
      "minLength": 1
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "contextRef": {
      "$ref": "#/$defs/id"
    },
    "parentContextRef": {
      "$ref": "#/$defs/id"
    },
    "rootRefs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/id"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "responsibleRoleRef": {
      "$ref": "#/$defs/id"
    },
    "roleRefs": {
      "description": "For Contract evidence, exactly two contextual Party Role IDs; explicit Participant players are optional.",
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "$ref": "#/$defs/id"
      },
      "uniqueItems": true
    },
    "attributes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/attribute"
      }
    },
    "notes": {
      "type": "string",
      "minLength": 1
    },
    "contractRef": {
      "$ref": "#/$defs/id"
    },
    "requestRef": {
      "$ref": "#/$defs/id"
    },
    "requestInterval": {
      "$ref": "#/$defs/requestInterval"
    },
    "confirmationRefs": {
      "description": "Stable IDs of concrete Fulfillment Confirmation entities or open Evidence Role confirmation slots.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/id"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "subjectRefs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/id"
      },
      "uniqueItems": true
    },
    "completionPolicy": {
      "$ref": "#/$defs/completionPolicy"
    },
    "requestTrigger": {
      "$ref": "#/$defs/trigger"
    },
    "confirmationTriggers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["confirmationRef", "trigger"],
        "properties": {
          "confirmationRef": {
            "description": "A member of confirmationRefs: concrete Confirmation or Evidence Role.",
            "$ref": "#/$defs/id"
          },
          "trigger": {
            "$ref": "#/$defs/trigger"
          }
        },
        "additionalProperties": false
      }
    },
    "breaches": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/breach"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "category": {
            "const": "evidence"
          },
          "kind": {
            "enum": ["rfp", "proposal", "fulfillment_request"]
          }
        },
        "required": ["category", "kind"]
      },
      "then": {
        "required": ["attributes"],
        "properties": {
          "attributes": {
            "allOf": [
              {
                "contains": {
                  "allOf": [
                    {
                      "$ref": "#/$defs/evidenceTime"
                    },
                    {
                      "properties": {
                        "name": {
                          "const": "started_at"
                        }
                      }
                    }
                  ]
                },
                "minContains": 1,
                "maxContains": 1
              },
              {
                "contains": {
                  "allOf": [
                    {
                      "$ref": "#/$defs/evidenceTime"
                    },
                    {
                      "properties": {
                        "name": {
                          "const": "expired_at"
                        }
                      }
                    }
                  ]
                },
                "minContains": 1,
                "maxContains": 1
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "category": {
            "const": "evidence"
          },
          "kind": {
            "const": "contract"
          }
        },
        "required": ["category", "kind"]
      },
      "then": {
        "required": ["attributes"],
        "properties": {
          "attributes": {
            "contains": {
              "allOf": [
                {
                  "$ref": "#/$defs/evidenceTime"
                },
                {
                  "properties": {
                    "name": {
                      "const": "signed_at"
                    }
                  }
                }
              ]
            },
            "minContains": 1,
            "maxContains": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "category": {
            "const": "evidence"
          },
          "kind": {
            "const": "fulfillment_confirmation"
          }
        },
        "required": ["category", "kind"]
      },
      "then": {
        "required": ["attributes"],
        "properties": {
          "attributes": {
            "contains": {
              "allOf": [
                {
                  "$ref": "#/$defs/evidenceTime"
                },
                {
                  "properties": {
                    "name": {
                      "const": "confirmed_at"
                    }
                  }
                }
              ]
            },
            "minContains": 1,
            "maxContains": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "category": {
            "const": "evidence"
          },
          "kind": {
            "const": "other_evidence"
          }
        },
        "required": ["category", "kind"]
      },
      "then": {
        "required": ["attributes"],
        "properties": {
          "attributes": {
            "contains": {
              "allOf": [
                {
                  "$ref": "#/$defs/evidenceTime"
                },
                {
                  "properties": {
                    "name": {
                      "const": "created_at"
                    }
                  }
                }
              ]
            },
            "minContains": 1,
            "maxContains": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "category": {
            "const": "evidence"
          }
        },
        "required": ["category"]
      },
      "then": {
        "properties": {
          "kind": {
            "enum": [
              "rfp",
              "proposal",
              "contract",
              "fulfillment_request",
              "fulfillment_confirmation",
              "other_evidence"
            ]
          }
        },
        "required": ["contextRef"]
      }
    },
    {
      "if": {
        "properties": {
          "category": {
            "const": "evidence"
          },
          "kind": {
            "enum": [
              "rfp",
              "proposal",
              "fulfillment_request",
              "fulfillment_confirmation",
              "other_evidence"
            ]
          }
        },
        "required": ["category", "kind"]
      },
      "then": {
        "required": ["responsibleRoleRef"]
      }
    },
    {
      "if": {
        "properties": {
          "category": {
            "const": "evidence"
          },
          "kind": {
            "const": "contract"
          }
        },
        "required": ["category", "kind"]
      },
      "then": {
        "required": ["roleRefs"]
      }
    },
    {
      "if": {
        "properties": {
          "category": {
            "const": "participant"
          }
        },
        "required": ["category"]
      },
      "then": {
        "properties": {
          "kind": {
            "enum": ["party", "thing"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "category": {
            "const": "participant"
          },
          "kind": {
            "const": "thing"
          }
        },
        "required": ["category", "kind"]
      },
      "then": {
        "required": ["contextRef"]
      }
    },
    {
      "if": {
        "properties": {
          "category": {
            "const": "role"
          }
        },
        "required": ["category"]
      },
      "then": {
        "properties": {
          "kind": {
            "enum": ["party", "domain", "third_party", "context", "evidence"]
          }
        },
        "required": ["contextRef"]
      }
    },
    {
      "if": {
        "properties": {
          "category": {
            "const": "context"
          }
        },
        "required": ["category"]
      },
      "then": {
        "properties": {
          "kind": {
            "enum": [
              "contract",
              "fulfillment",
              "pre_contract",
              "channel",
              "domain",
              "external"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "category": {
            "const": "context"
          },
          "kind": {
            "const": "fulfillment"
          }
        },
        "required": ["category", "kind"]
      },
      "then": {
        "required": [
          "parentContextRef",
          "contractRef",
          "requestRef",
          "requestInterval",
          "confirmationRefs",
          "completionPolicy",
          "requestTrigger",
          "confirmationTriggers"
        ],
        "not": {
          "required": ["contextRef"]
        }
      },
      "else": {
        "not": {
          "anyOf": [
            {
              "required": ["contractRef"]
            },
            {
              "required": ["requestRef"]
            },
            {
              "required": ["requestInterval"]
            },
            {
              "required": ["confirmationRefs"]
            },
            {
              "required": ["subjectRefs"]
            },
            {
              "required": ["completionPolicy"]
            },
            {
              "required": ["requestTrigger"]
            },
            {
              "required": ["confirmationTriggers"]
            },
            {
              "required": ["breaches"]
            }
          ]
        }
      }
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "evidenceTime": {
      "type": "object",
      "required": ["name", "valueType", "required", "keyData"],
      "properties": {
        "valueType": {
          "const": "timestamp"
        },
        "required": {
          "const": true
        },
        "keyData": {
          "const": true
        }
      }
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
    },
    "attribute": {
      "type": "object",
      "required": ["name", "label", "valueType", "required", "meaning"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "valueType": {
          "enum": [
            "bool",
            "int",
            "uint",
            "double",
            "decimal",
            "string",
            "bytes",
            "timestamp",
            "duration",
            "date",
            "money",
            "enum",
            "id",
            "list",
            "map",
            "dynamic"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "keyData": {
          "description": "Marks a financially, temporally, quantitatively, or audit-significant value for lineage reporting.",
          "type": "boolean"
        },
        "meaning": {
          "type": "string",
          "minLength": 1
        },
        "derivedByRuleRef": {
          "$ref": "#/$defs/id"
        },
        "notes": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "requestInterval": {
      "type": "object",
      "required": ["startAttribute", "endAttribute"],
      "properties": {
        "startAttribute": {
          "const": "started_at"
        },
        "endAttribute": {
          "const": "expired_at"
        }
      },
      "additionalProperties": false
    },
    "completionPolicy": {
      "type": "object",
      "required": ["mode"],
      "properties": {
        "mode": {
          "enum": ["any", "all", "count", "amount", "manual"]
        },
        "minimumConfirmations": {
          "type": "integer",
          "minimum": 1
        },
        "completionRuleRef": {
          "$ref": "#/$defs/id"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "count"
              }
            },
            "required": ["mode"]
          },
          "then": {
            "required": ["minimumConfirmations"]
          },
          "else": {
            "not": {
              "required": ["minimumConfirmations"]
            }
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "amount"
              }
            },
            "required": ["mode"]
          },
          "then": {
            "required": ["completionRuleRef"]
          }
        }
      ],
      "additionalProperties": false
    },
    "trigger": {
      "type": "object",
      "required": ["kind", "actsForRoleRef"],
      "properties": {
        "kind": {
          "enum": [
            "manual",
            "schedule",
            "domain_event",
            "integration_event",
            "rule"
          ]
        },
        "actsForRoleRef": {
          "$ref": "#/$defs/id"
        },
        "eventType": {
          "type": "string",
          "pattern": "^[A-Z][A-Za-z0-9]*$"
        },
        "schedule": {
          "type": "string",
          "minLength": 1
        },
        "ruleRef": {
          "$ref": "#/$defs/id"
        },
        "sourceContextRef": {
          "$ref": "#/$defs/id"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "enum": ["domain_event", "integration_event"]
              }
            },
            "required": ["kind"]
          },
          "then": {
            "required": ["eventType"]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "schedule"
              }
            },
            "required": ["kind"]
          },
          "then": {
            "required": ["schedule"]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "rule"
              }
            },
            "required": ["kind"]
          },
          "then": {
            "required": ["ruleRef"]
          }
        }
      ],
      "additionalProperties": false
    },
    "breach": {
      "type": "object",
      "required": ["conditionRuleRef", "outcome"],
      "properties": {
        "conditionRuleRef": {
          "$ref": "#/$defs/id"
        },
        "outcome": {
          "type": "object",
          "required": ["kind"],
          "properties": {
            "kind": {
              "enum": [
                "fulfillment",
                "terminate_contract",
                "external_dispute",
                "record_only"
              ]
            },
            "fulfillmentRef": {
              "$ref": "#/$defs/id"
            },
            "notes": {
              "type": "string",
              "minLength": 1
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "kind": {
                    "const": "fulfillment"
                  }
                },
                "required": ["kind"]
              },
              "then": {
                "required": ["fulfillmentRef"]
              }
            },
            {
              "if": {
                "properties": {
                  "kind": {
                    "const": "record_only"
                  }
                },
                "required": ["kind"]
              },
              "then": {
                "required": ["notes"]
              }
            }
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
