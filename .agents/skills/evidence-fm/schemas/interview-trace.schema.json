{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jayclock.dev/fm/v5/interview-trace.schema.json",
  "title": "Interview process and evidence provenance trace record",
  "type": "object",
  "required": ["schemaVersion", "modelId", "traces"],
  "properties": {
    "schemaVersion": { "const": "5.0" },
    "modelId": { "$ref": "#/$defs/id" },
    "traces": {
      "type": "array",
      "items": { "$ref": "#/$defs/traceRecord" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
    },
    "attributePath": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*#[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
    },
    "traceRecord": {
      "type": "object",
      "required": [
        "traceId",
        "timestamp",
        "focus",
        "narrative",
        "qa",
        "userInput",
        "targetBindings"
      ],
      "properties": {
        "traceId": { "type": "string", "minLength": 1 },
        "timestamp": { "type": "string", "format": "date-time" },
        "focus": {
          "type": "object",
          "required": ["evidenceRef"],
          "properties": {
            "contextRef": { "$ref": "#/$defs/id" },
            "fulfillmentRef": { "$ref": "#/$defs/id" },
            "evidenceRef": { "$ref": "#/$defs/id" },
            "roleRef": { "$ref": "#/$defs/id" }
          },
          "additionalProperties": false
        },
        "narrative": {
          "type": "object",
          "required": ["judgment", "story"],
          "properties": {
            "judgment": { "type": "string", "minLength": 1 },
            "keyData": {
              "type": "array",
              "items": { "type": "string" }
            },
            "story": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        "qa": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["questionId", "question"],
            "properties": {
              "questionId": { "type": "string", "pattern": "^Q[0-9]+$" },
              "targetAttribute": { "$ref": "#/$defs/attributePath" },
              "question": { "type": "string", "minLength": 1 },
              "intent": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "userInput": {
          "type": "object",
          "required": ["rawText", "confirmedFacts"],
          "properties": {
            "rawText": { "type": "string", "minLength": 1 },
            "confirmedFacts": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            }
          },
          "additionalProperties": false
        },
        "targetBindings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["evidenceRef", "sourceType"],
            "properties": {
              "evidenceRef": { "$ref": "#/$defs/id" },
              "attributeName": { "type": "string" },
              "sourceType": {
                "enum": [
                  "interview_statement",
                  "upstream_evidence",
                  "system_rule",
                  "document"
                ]
              },
              "upstreamEvidenceRef": { "$ref": "#/$defs/id" },
              "sourceDescription": { "type": "string" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  }
}
