{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jayclock.dev/fm/v3/relationship.schema.json",
  "title": "Fulfillment Modeling relationship",
  "type": "object",
  "required": ["type", "id", "kind", "sourceRef", "targetRef", "label"],
  "properties": {
    "type": {
      "const": "relationship"
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "kind": {
      "enum": [
        "plays_role",
        "references",
        "evidences",
        "precedes",
        "derived_from",
        "uses_role"
      ]
    },
    "sourceRef": {
      "$ref": "#/$defs/id"
    },
    "targetRef": {
      "$ref": "#/$defs/id"
    },
    "sourceCardinality": {
      "$ref": "#/$defs/cardinality"
    },
    "targetCardinality": {
      "$ref": "#/$defs/cardinality"
    },
    "label": {
      "type": "string",
      "minLength": 1
    },
    "notes": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false,
  "$defs": {
    "cardinality": {
      "type": "object",
      "required": ["min", "max"],
      "properties": {
        "min": {
          "type": "integer",
          "minimum": 0
        },
        "max": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "const": "many"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
    }
  }
}
