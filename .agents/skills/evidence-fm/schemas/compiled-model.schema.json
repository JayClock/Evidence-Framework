{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jayclock.dev/fm/v5/compiled-model.schema.json",
  "title": "Compiled Fulfillment Modeling document",
  "type": "object",
  "required": ["schemaVersion", "model", "entities", "relationships", "rules"],
  "properties": {
    "schemaVersion": { "const": "5.0" },
    "model": { "$ref": "model.schema.json" },
    "entities": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "entity.schema.json" }
    },
    "relationships": {
      "type": "array",
      "items": { "$ref": "relationship.schema.json" }
    },
    "rules": {
      "type": "array",
      "items": { "$ref": "rule.schema.json" }
    }
  },
  "additionalProperties": false
}
