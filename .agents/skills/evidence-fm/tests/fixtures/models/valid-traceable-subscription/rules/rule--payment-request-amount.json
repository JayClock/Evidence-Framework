{
  "type": "rule",
  "id": "rule.payment-request-amount",
  "kind": "derivation",
  "label": "从合同派生请求支付金额",
  "description": "读取内容产品订阅合同（Content Subscription Contract）[contract.content-subscription]约定的最小货币单位价格，并将其作为内容产品付款请求（Content Payment Request）[request.content-payment]的金额。",
  "contextRef": "context.content-subscription",
  "bindings": {
    "contract": {
      "ref": "contract.content-subscription"
    }
  },
  "expression": "contract.price_minor_units",
  "resultType": "int",
  "target": {
    "entityRef": "request.content-payment",
    "attribute": "requested_minor_units"
  },
  "fulfillmentRef": "fulfillment.content-payment"
}
