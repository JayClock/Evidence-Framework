{
  "type": "rule",
  "id": "rule.payment-request-currency",
  "kind": "derivation",
  "label": "从合同派生请求支付币种",
  "description": "读取内容产品订阅合同（Content Subscription Contract）[contract.content-subscription]约定的币种，并将其作为内容产品付款请求（Content Payment Request）[request.content-payment]的币种。",
  "contextRef": "context.content-subscription",
  "bindings": {
    "contract": {
      "ref": "contract.content-subscription"
    }
  },
  "expression": "contract.currency",
  "resultType": "string",
  "target": {
    "entityRef": "request.content-payment",
    "attribute": "currency"
  },
  "fulfillmentRef": "fulfillment.content-payment"
}
