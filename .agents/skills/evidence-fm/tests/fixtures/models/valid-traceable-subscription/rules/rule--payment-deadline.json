{
  "type": "rule",
  "id": "rule.payment-deadline",
  "kind": "derivation",
  "label": "付款截止时间",
  "description": "以内容产品付款请求（Content Payment Request）[request.content-payment]的开始时间为基准增加约定的 30 分钟付款期限，得到该请求的截止时间。",
  "contextRef": "context.content-subscription",
  "bindings": {
    "self": {
      "ref": "request.content-payment"
    }
  },
  "expression": "self.started_at + duration(\"30m\")",
  "resultType": "timestamp",
  "target": {
    "entityRef": "request.content-payment",
    "attribute": "expired_at"
  },
  "fulfillmentRef": "fulfillment.content-payment"
}
