{
  "type": "rule",
  "id": "rule.advance-payment-completed",
  "kind": "completion",
  "label": "支付创作者预付款完成判断",
  "description": "存在至少一份与请求（request.advance-payment）关联的确认凭证（confirmation.advance-payment）时，判定履约（fulfillment.advance-payment）完成。",
  "contextRef": "fulfillment.advance-payment",
  "bindings": {
    "request": {
      "ref": "request.advance-payment"
    },
    "confirmations": {
      "ref": "confirmation.advance-payment",
      "cardinality": "many"
    }
  },
  "expression": "confirmations.size() > 0",
  "resultType": "bool"
}
