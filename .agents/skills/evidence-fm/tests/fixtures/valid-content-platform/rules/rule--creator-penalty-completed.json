  "contextRef": "fulfillment.creator-penalty",
  "bindings": {
    "request": {
      "ref": "request.creator-penalty"
    },
    "confirmations": {
      "ref": "confirmation.creator-penalty",
      "cardinality": "many"
    }
  },
  "expression": "confirmations.size() > 0",
  "resultType": "bool"
}
