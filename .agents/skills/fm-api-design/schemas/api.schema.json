{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evidence.local/fm-api-design/v4/api.schema.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "sources",
    "decisions",
    "resources",
    "bindings",
    "scenarios",
    "capabilities",
    "representations",
    "journeys",
    "http",
    "nonApiActivities"
  ],
  "properties": {
    "schemaVersion": {
      "const": "4.0"
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/decision"
      }
    },
    "resources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/resource"
      }
    },
    "bindings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/binding"
      }
    },
    "scenarios": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/scenario"
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/capability"
      }
    },
    "representations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/representation"
      }
    },
    "journeys": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/journey"
      }
    },
    "http": {
      "$ref": "#/$defs/http"
    },
    "nonApiActivities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["entityRef", "handling", "basis"],
        "properties": {
          "entityRef": {
            "$ref": "#/$defs/id"
          },
          "handling": {
            "enum": ["internal", "external"]
          },
          "basis": {
            "$ref": "#/$defs/basis"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
    },
    "ids": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/id"
      },
      "uniqueItems": true
    },
    "basis": {
      "type": "object",
      "required": ["reasoning"],
      "properties": {
        "fmRefs": {
          "$ref": "#/$defs/ids"
        },
        "sourceRefs": {
          "$ref": "#/$defs/ids"
        },
        "decisionRefs": {
          "$ref": "#/$defs/ids"
        },
        "reasoning": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": ["id", "path", "locator", "quote"],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "quote": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "decision": {
      "type": "object",
      "required": ["id", "category", "statement", "reasoning"],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "category": {
          "enum": [
            "resource",
            "identity",
            "navigation",
            "representation",
            "http",
            "other"
          ]
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "reasoning": {
          "type": "string",
          "minLength": 1
        },
        "sourceRefs": {
          "$ref": "#/$defs/ids"
        }
      },
      "additionalProperties": false
    },
    "identity": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "parameter", "attributeRef"],
          "properties": {
            "kind": {
              "const": "fm_attribute"
            },
            "parameter": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9]*$"
            },
            "attributeRef": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*#[a-z][a-z0-9_]*$"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "parameter", "decisionRef"],
          "properties": {
            "kind": {
              "const": "api_resource_id"
            },
            "parameter": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9]*$"
            },
            "decisionRef": {
              "$ref": "#/$defs/id"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind"],
          "properties": {
            "kind": {
              "const": "parent_scoped"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "resource": {
      "type": "object",
      "required": [
        "id",
        "entityRef",
        "segment",
        "identity",
        "basis",
        "businessName",
        "shape"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "entityRef": {
          "$ref": "#/$defs/id"
        },
        "segment": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "identity": {
          "$ref": "#/$defs/identity"
        },
        "parentRef": {
          "$ref": "#/$defs/id"
        },
        "parentBindingRef": {
          "$ref": "#/$defs/id"
        },
        "basis": {
          "$ref": "#/$defs/basis"
        },
        "businessName": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "shape": {
          "enum": ["singleton", "collection"]
        },
        "cardinality": {
          "$ref": "#/$defs/cardinality"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "shape": {
                "const": "singleton"
              }
            }
          },
          "then": {
            "required": ["parentRef"],
            "properties": {
              "identity": {
                "properties": {
                  "kind": {
                    "const": "parent_scoped"
                  }
                }
              }
            }
          },
          "else": {
            "properties": {
              "identity": {
                "properties": {
                  "kind": {
                    "enum": ["fm_attribute", "api_resource_id"]
                  }
                }
              }
            }
          }
        }
      ]
    },
    "binding": {
      "oneOf": [
        {
          "type": "object",
          "required": ["id", "kind", "roleRef", "scopeResourceRef", "basis"],
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "kind": {
              "const": "caller_role"
            },
            "roleRef": {
              "$ref": "#/$defs/id"
            },
            "scopeResourceRef": {
              "$ref": "#/$defs/id"
            },
            "basis": {
              "$ref": "#/$defs/basis"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "id",
            "kind",
            "parentResourceRef",
            "childResourceRef",
            "basis"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "kind": {
              "const": "parent_child"
            },
            "parentResourceRef": {
              "$ref": "#/$defs/id"
            },
            "childResourceRef": {
              "$ref": "#/$defs/id"
            },
            "basis": {
              "$ref": "#/$defs/basis"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "scenario": {
      "type": "object",
      "required": ["id", "sourceScenarioRef", "basis"],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "sourceScenarioRef": {
          "$ref": "#/$defs/id"
        },
        "basis": {
          "$ref": "#/$defs/basis"
        }
      },
      "additionalProperties": false
    },
    "ruleBinding": {
      "type": "object",
      "required": ["ruleRef", "purpose"],
      "properties": {
        "ruleRef": {
          "$ref": "#/$defs/id"
        },
        "purpose": {
          "enum": ["precondition", "derivation", "result"]
        }
      },
      "additionalProperties": false
    },
    "effect": {
      "type": "object",
      "required": ["kind", "targetRef"],
      "properties": {
        "kind": {
          "enum": [
            "read",
            "append_evidence",
            "create_domain_object",
            "update_domain_object",
            "remove_domain_object"
          ]
        },
        "targetRef": {
          "$ref": "#/$defs/id"
        }
      },
      "additionalProperties": false
    },
    "capability": {
      "type": "object",
      "required": [
        "id",
        "actorRoleRef",
        "resourceRef",
        "view",
        "method",
        "effect",
        "businessCapability",
        "scenarioRefs",
        "bindingRefs",
        "basis"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "actorRoleRef": {
          "$ref": "#/$defs/id"
        },
        "resourceRef": {
          "$ref": "#/$defs/id"
        },
        "view": {
          "enum": ["singleton", "collection", "item"]
        },
        "method": {
          "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"]
        },
        "effect": {
          "$ref": "#/$defs/effect"
        },
        "businessCapability": {
          "type": "string",
          "minLength": 1
        },
        "scenarioRefs": {
          "$ref": "#/$defs/ids"
        },
        "bindingRefs": {
          "$ref": "#/$defs/ids"
        },
        "ruleBindings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ruleBinding"
          }
        },
        "basis": {
          "$ref": "#/$defs/basis"
        }
      },
      "additionalProperties": false
    },
    "field": {
      "type": "object",
      "required": ["name", "fmAttributeRef"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "fmAttributeRef": {
          "type": "string",
          "minLength": 3
        }
      },
      "additionalProperties": false
    },
    "parameterBinding": {
      "type": "object",
      "required": ["parameter", "fromParameter"],
      "properties": {
        "parameter": {
          "type": "string",
          "minLength": 1
        },
        "fromParameter": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "link": {
      "type": "object",
      "required": [
        "rel",
        "targetResourceRef",
        "targetView",
        "parameterBindings"
      ],
      "properties": {
        "rel": {
          "type": "string",
          "minLength": 1
        },
        "targetResourceRef": {
          "$ref": "#/$defs/id"
        },
        "targetView": {
          "enum": ["singleton", "collection", "item"]
        },
        "parameterBindings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/parameterBinding"
          }
        },
        "visibleToRoleRefs": {
          "$ref": "#/$defs/ids"
        },
        "capabilityRef": {
          "$ref": "#/$defs/id"
        },
        "externalHref": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "representation": {
      "type": "object",
      "required": [
        "id",
        "resourceRef",
        "view",
        "format",
        "fields",
        "links",
        "basis"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "resourceRef": {
          "$ref": "#/$defs/id"
        },
        "view": {
          "enum": ["singleton", "collection", "item"]
        },
        "format": {
          "enum": ["json", "hal"]
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/field"
          }
        },
        "links": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/link"
          }
        },
        "basis": {
          "$ref": "#/$defs/basis"
        }
      },
      "additionalProperties": false
    },
    "journeyStep": {
      "type": "object",
      "required": [
        "id",
        "sourceStepSequence",
        "description",
        "mapping",
        "basis"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "sourceStepSequence": {
          "type": "integer",
          "minimum": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "mapping": {
          "enum": ["capability", "internal", "external", "gap"]
        },
        "capabilityRef": {
          "$ref": "#/$defs/id"
        },
        "basis": {
          "$ref": "#/$defs/basis"
        }
      },
      "additionalProperties": false
    },
    "journey": {
      "type": "object",
      "required": ["id", "scenarioRef", "steps"],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "scenarioRef": {
          "$ref": "#/$defs/id"
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/journeyStep"
          }
        }
      },
      "additionalProperties": false
    },
    "cardinality": {
      "oneOf": [
        {
          "type": "object",
          "required": ["relationshipRef"],
          "properties": {
            "relationshipRef": {
              "$ref": "#/$defs/id"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["max", "sourceRefs", "reasoning"],
          "properties": {
            "max": {
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": 1
                },
                {
                  "const": "many"
                }
              ]
            },
            "sourceRefs": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/id"
              },
              "uniqueItems": true,
              "minItems": 1
            },
            "reasoning": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "httpText": {
      "type": "string",
      "minLength": 1
    },
    "httpStrings": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/httpText"
      }
    },
    "httpField": {
      "type": "object",
      "required": ["name", "schema", "required", "origin"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_]*$"
        },
        "schema": {
          "type": "object"
        },
        "required": {
          "type": "boolean"
        },
        "origin": {
          "enum": ["client", "reference", "server", "derived"]
        },
        "fmAttributeRef": {
          "$ref": "#/$defs/httpText"
        },
        "decision": {
          "$ref": "#/$defs/httpText"
        }
      },
      "oneOf": [
        {
          "required": ["fmAttributeRef"]
        },
        {
          "required": ["decision"]
        }
      ],
      "additionalProperties": false
    },
    "httpPayload": {
      "type": "object",
      "required": ["mediaType", "fields", "example"],
      "properties": {
        "mediaType": {
          "enum": ["application/json", "application/hal+json"]
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/httpField"
          }
        },
        "example": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "httpLinkSource": {
      "type": "object",
      "required": ["kind", "name"],
      "properties": {
        "kind": {
          "enum": ["path", "field"]
        },
        "name": {
          "$ref": "#/$defs/httpText"
        }
      },
      "additionalProperties": false
    },
    "httpLink": {
      "type": "object",
      "required": ["rel", "kind", "capabilityRef", "parameterBindings"],
      "properties": {
        "rel": {
          "$ref": "#/$defs/httpText"
        },
        "kind": {
          "enum": ["navigation", "action"]
        },
        "capabilityRef": {
          "$ref": "#/$defs/httpText"
        },
        "whenRuleRef": {
          "$ref": "#/$defs/httpText"
        },
        "parameterBindings": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/httpLinkSource"
          }
        }
      },
      "additionalProperties": false
    },
    "httpCache": {
      "type": "object",
      "required": ["mode", "reason"],
      "properties": {
        "mode": {
          "enum": ["no-store", "private", "public"]
        },
        "reason": {
          "$ref": "#/$defs/httpText"
        },
        "maxAge": {
          "type": "integer",
          "minimum": 0
        },
        "validator": {
          "enum": ["etag", "last-modified"]
        },
        "publicInvariantReason": {
          "$ref": "#/$defs/httpText"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "enum": ["private", "public"]
              }
            }
          },
          "then": {
            "required": ["maxAge", "validator"]
          }
        }
      ]
    },
    "httpRepresentation": {
      "type": "object",
      "required": [
        "id",
        "resourceRef",
        "view",
        "actorRoleRefs",
        "mediaType",
        "fields",
        "example",
        "exampleParameters",
        "links",
        "cache"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/httpText"
        },
        "resourceRef": {
          "$ref": "#/$defs/httpText"
        },
        "view": {
          "enum": ["collection", "item", "singleton"]
        },
        "actorRoleRefs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/httpText"
          }
        },
        "mediaType": {
          "enum": ["application/json", "application/hal+json"]
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/httpField"
          }
        },
        "example": {
          "type": "object"
        },
        "exampleParameters": {
          "type": "object",
          "additionalProperties": {
            "type": ["string", "integer"]
          }
        },
        "links": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/httpLink"
          }
        },
        "cache": {
          "$ref": "#/$defs/httpCache"
        },
        "embedded": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["rel", "representationRefs"],
            "properties": {
              "rel": {
                "$ref": "#/$defs/httpText"
              },
              "representationRefs": {
                "$ref": "#/$defs/httpStrings"
              }
            },
            "additionalProperties": false
          }
        },
        "pagination": {
          "type": "object",
          "required": ["mode", "parameter", "nextExample", "reason"],
          "properties": {
            "mode": {
              "enum": ["cursor", "page"]
            },
            "parameter": {
              "$ref": "#/$defs/httpText"
            },
            "nextExample": {
              "$ref": "#/$defs/httpText"
            },
            "reason": {
              "$ref": "#/$defs/httpText"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "httpResponse": {
      "type": "object",
      "required": ["status", "description", "headers"],
      "properties": {
        "status": {
          "type": "integer",
          "minimum": 200,
          "maximum": 599
        },
        "description": {
          "$ref": "#/$defs/httpText"
        },
        "headers": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "representationRef": {
          "$ref": "#/$defs/httpText"
        },
        "resultCapabilityRef": {
          "$ref": "#/$defs/httpText"
        }
      },
      "additionalProperties": false
    },
    "httpOperation": {
      "type": "object",
      "required": [
        "capabilityRef",
        "request",
        "responses",
        "idempotency",
        "concurrency"
      ],
      "properties": {
        "capabilityRef": {
          "$ref": "#/$defs/httpText"
        },
        "request": {
          "$ref": "#/$defs/httpPayload"
        },
        "responses": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/httpResponse"
          }
        },
        "idempotency": {
          "type": "object",
          "required": ["mode", "reason"],
          "properties": {
            "mode": {
              "enum": ["none", "key", "not_applicable"]
            },
            "reason": {
              "$ref": "#/$defs/httpText"
            },
            "header": {
              "$ref": "#/$defs/httpText"
            },
            "samePayload": {
              "const": "replay"
            },
            "differentPayload": {
              "const": "reject"
            }
          },
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "mode": {
                    "const": "key"
                  }
                }
              },
              "then": {
                "required": ["header", "samePayload", "differentPayload"]
              }
            }
          ]
        },
        "concurrency": {
          "type": "object",
          "required": ["mode", "reason"],
          "properties": {
            "mode": {
              "enum": ["none", "if-match"]
            },
            "reason": {
              "$ref": "#/$defs/httpText"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "httpSource": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "value", "reason"],
          "properties": {
            "kind": {
              "const": "literal"
            },
            "value": {},
            "reason": {
              "$ref": "#/$defs/httpText"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "stepRef", "name"],
          "properties": {
            "kind": {
              "enum": ["response_field", "response_header"]
            },
            "stepRef": {
              "$ref": "#/$defs/httpText"
            },
            "name": {
              "$ref": "#/$defs/httpText"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "httpStep": {
      "type": "object",
      "required": ["id", "capabilityRef", "expectStatus", "inputs"],
      "properties": {
        "id": {
          "$ref": "#/$defs/httpText"
        },
        "capabilityRef": {
          "$ref": "#/$defs/httpText"
        },
        "expectStatus": {
          "type": "integer",
          "minimum": 200,
          "maximum": 599
        },
        "entry": {
          "$ref": "#/$defs/httpText"
        },
        "via": {
          "type": "object",
          "required": ["stepRef"],
          "properties": {
            "stepRef": {
              "$ref": "#/$defs/httpText"
            },
            "rel": {
              "$ref": "#/$defs/httpText"
            },
            "header": {
              "const": "Location"
            }
          },
          "oneOf": [
            {
              "required": ["rel"]
            },
            {
              "required": ["header"]
            }
          ],
          "additionalProperties": false
        },
        "inputs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["target", "name", "source"],
            "properties": {
              "target": {
                "enum": ["path", "body", "header"]
              },
              "name": {
                "$ref": "#/$defs/httpText"
              },
              "source": {
                "$ref": "#/$defs/httpSource"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "oneOf": [
        {
          "required": ["entry"]
        },
        {
          "required": ["via"]
        }
      ],
      "additionalProperties": false
    },
    "httpJourney": {
      "type": "object",
      "required": ["id", "actorRoleRef", "steps"],
      "properties": {
        "id": {
          "$ref": "#/$defs/httpText"
        },
        "actorRoleRef": {
          "$ref": "#/$defs/httpText"
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/httpStep"
          }
        }
      },
      "additionalProperties": false
    },
    "http": {
      "type": "object",
      "required": ["representations", "operations", "journeys"],
      "properties": {
        "representations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/httpRepresentation"
          }
        },
        "operations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/httpOperation"
          }
        },
        "journeys": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/httpJourney"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
